  "first": "0641_0010001",
  "entries": [
   {
    "name": "0641_0010001",
    "ko": "아파로이드는 대충\n정리된 것 같군."
   },
   {
    "name": "0641_0020003",
    "ko": "이제 사우리아도 한시름 놓겠지?"
   },
   {
    "name": "0641_0030024",
    "ko": "폭스~~~~~!!"
   },
   {
    "name": "0641_0040001",
    "ko": "트리키"
   },
   {
    "name": "0641_0060024",
    "ko": "꼭 와 줄 줄 알았어! 고마워!\n폭스! 크리스탈~!"
   },
   {
    "name": "0641_0070001",
    "ko": "트리키… 무거워… 아야야"
   },
   {
    "name": "0641_0110024",
    "ko": "폭스… 그 녀석들이랑 싸우고 있지?\n나도 같이 가서 싸울래!"
   },
   {
    "name": "0641_0120001",
    "ko": "그래… 하지만 네가 싸울 곳은 여기야\n사우리아는 너한테 맡긴다!"
   },
   {
    "name": "0641_0130001",
    "ko": "여기 대장은 너야!\n트리키!"
   },
   {
    "name": "0641_0140024",
    "ko": "그렇구나… 응! 알았어!"
   },
   {
    "name": "0641_0150024",
    "ko": "내가 그 녀석들 싹 쓸어버려서\n신혼여행 올 수 있게 해 둘게!"
   },
   {
    "name": "0641_0160001",
    "ko": "뭐, 뭐라는 거야!\n나랑 크리스탈은 아직…"
   },
   {
    "name": "0641_0170024",
    "ko": "아직?"
   },
   {
    "name": "0641_0180001",
    "ko": "아니… 그게… 꼬맹이가\n건방진 소리 하는 거 아냐!"
   },
   {
    "name": "0641_0190024",
    "ko": "어린애 취급은 안 한다고 했잖아!"
   },
   {
    "name": "0641_0200001",
    "ko": "건방진 소리를 하니까 그렇지!"
   },
   {
    "name": "0641_0210024",
    "ko": "쳇, 자기가 불리하니까!"
   },
   {
    "name": "0641_0220003",
    "ko": "자자, 둘 다 거기까지!"
   }
  ]
 }
]