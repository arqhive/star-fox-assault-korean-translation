[
 {
  "path": [],
  "first": "2300_0080002",
  "entries": [
   {
    "name": "2300_0080002",
    "ko": "해냈구나! 폭스!"
   },
   {
    "name": "2300_0090004",
    "ko": "아직 살아 있다는 게\n믿기지 않아…"
   },
   {
    "name": "2300_0100003",
    "ko": "하지만… 소중한 희생이었어. 페피…\n울프 팀… 수많은 사람들…"
   },
   {
    "name": "2300_0120001",
    "ko": "왜 그래! 슬리피!"
   },
   {
    "name": "2300_0130003",
    "ko": "저건…?"
   },
   {
    "name": "2300_0140002",
    "ko": "어이… 설마!? …혹시…"
   },
   {
    "name": "2300_0150005",
    "ko": "어~이, 너희들~! 휴, 큰일 날 뻔했구먼\n이번에야말로 나는 은퇴할 거다!"
   },
   {
    "name": "2300_0160004",
    "ko": "페피다아아앗!\n우하하하하~이!"
   },
   {
    "name": "2300_0170001",
    "ko": "어서 와, 페피"
   },
   {
    "name": "2300_0180002",
    "ko": "폭스! 너 이 자식!?\n알고 있었구나!"
   },
   {
    "name": "2300_0200004",
    "ko": "그래서 그때 침착했던 거야?\n너무해!"
   },
   {
    "name": "2300_0210003",
    "ko": "페퍼 장군도 무사할까?"
   },
   {
    "name": "2300_0220001",
    "ko": "그래. 어쩌면 울프 일당도…"
   },
   {
    "name": "2300_0230001",
    "ko": "…다들…"
   },
   {
    "name": "2300_0240002",
    "ko": "오우!"
   },
   {
    "name": "2300_0250004",
    "ko": "뭔데?"
   },
   {
    "name": "2300_0260003",
    "ko": "왜?"
   },
   {
    "name": "2300_0270005",
    "ko": "응? 왜 그러냐? 폭스"
   },
   {
    "name": "2300_0280001",
    "ko": "다들…"
   },
   {
    "name": "2300_0281001",
    "ko": "고마워."
   }
  ]
 }
]