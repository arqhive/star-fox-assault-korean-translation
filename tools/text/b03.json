[
 {
  "path": [],
  "first": "0301_0010005",
  "entries": [
   {
    "name": "0301_0010005",
    "ko": "페피\n피그마 녀석!\n골치 아픈 곳으로 도망쳤군."
   },
   {
    "name": "0301_0020004",
    "ko": "슬리피\n여기는 무법자들 소굴이라고\n소문난 콜로니지…"
   },
   {
    "name": "0301_0030027",
    "ko": "무법자\n네놈들! 여기가 오도넬 님의\n구역인 줄 알고 온 거냐?"
   },
   {
    "name": "0301_0040002",
    "ko": "팔코\n벌써 나오셨군."
   },
   {
    "name": "0301_0050001",
    "ko": "폭스\n우리는 스타폭스다!"
   },
   {
    "name": "0301_0060001",
    "ko": "폭스\n볼일 있는 건 피그마뿐이다!\n싸우러 온 게 아니야!"
   },
   {
    "name": "0301_0070027",
    "ko": "무법자\n피그마인지 멍청이인지 모르겠지만"
   },
   {
    "name": "0301_0080027",
    "ko": "무법자\n스타폭스라니\n가만있을 수가 없지~"
   },
   {
    "name": "0301_0090027",
    "ko": "무법자\n이놈들아!\n여우 놈들을 때려눕히자!"
   },
   {
    "name": "0301_0110027",
    "ko": "무법자\n동료를 더 불러 모아!"
   },
   {
    "name": "0301_0120004",
    "ko": "슬리피\n다들, 아빠한테서 전언이야!\n피그마가 가진 〈코어 메모리〉라면"
   },
   {
    "name": "0301_0130004",
    "ko": "슬리피\n아파로이드 본거지를\n알 수 있을지도 모른대!"
   },
   {
    "name": "0301_0140004",
    "ko": "슬리피\n무슨 일이 있어도\n되찾아야 해!"
   },
   {
    "name": "0301_0150020",
    "ko": "나우스\n전송 장치 작동을 확인\n적의 수가 증가 중입니다."
   },
   {
    "name": "0301_0160001",
    "ko": "폭스\n정면으로 부딪쳐도\n소모전이 될 뿐이야."
   },
   {
    "name": "0301_0170001",
    "ko": "폭스\n전송 장치를 어떻게든 해야겠군…"
   },
   {
    "name": "0301_0180001",
    "ko": "폭스\n좋아! 나와 슬리피는\n콜로니의 전송 장치를 파괴하고 올게."
   },
   {
    "name": "0301_0190005",
    "ko": "페피\n알았다!"
   },
   {
    "name": "0301_0200005",
    "ko": "페피\n팔코와 크리스탈은\n바깥 전함을 처리해 줘!"
   },
   {
    "name": "0301_0210002",
    "ko": "팔코\n오케이, 우주는 맡겨!"
   },
   {
    "name": "0301_0220003",
    "ko": "크리스탈\n폭스, 조심해."
   },
   {
    "name": "0301_0230001",
    "ko": "폭스\n그래! 크리스탈도!"
   },
   {
    "name": "title3",
    "ko": "사르가소"
   }
  ]
 },
