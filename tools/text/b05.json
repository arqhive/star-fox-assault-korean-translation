   {
    "name": "0501_0010020",
    "ko": "나우스\n피그마 기체 포착\n전방의 소행성입니다."
   },
   {
    "name": "0501_0020002",
    "ko": "팔코\n흥!\n이런 데로 도망치다니!"
   },
   {
    "name": "0501_0030002",
    "ko": "팔코\n우리를 따돌릴 수 있을\n거라 생각하는 거냐?"
   },
   {
    "name": "0501_0040002",
    "ko": "팔코\n얕보지 마라, 피그마!"
   },
   {
    "name": "0501_0050001",
    "ko": "폭스\n전직 우주 폭주족한테는\n안방 같은 곳인가?"
   },
   {
    "name": "0501_0060002",
    "ko": "팔코\n뭐, 그렇지!"
   },
   {
    "name": "0501_0070005",
    "ko": "페피\n좋아! 이번에야말로 피그마에게서\n〈코어 메모리〉를 되찾는 거다!"
   },
   {
    "name": "title5",
    "ko": "소행성대"
   }
  ]
 },
