   },
   {
    "name": "0000_0260003",
    "ko": "괜찮아!? 폭스!"
   },
   {
    "name": "0000_0260004",
    "ko": "괜찮아!?\n폭스!"
   },
   {
    "name": "0000_0270002",
    "ko": "컨디션이 안 좋아 보이는데\n폭스."
   },
   {
    "name": "0000_0270003",
    "ko": "폭스\n힘내!!"
   },
   {
    "name": "0000_0270004",
    "ko": "폭스가 저러는 건\n못 보겠어~"
   },
   {
    "name": "0000_0300902",
    "ko": "폭스!\n뒤에 붙은 적 좀 부탁해!"
   },
   {
    "name": "0000_0300904",
    "ko": "폭스! 뒤에 붙은 적 좀\n어떻게 해 줘~"
   },
   {
    "name": "0000_0310902",
    "ko": "폭스! 빨리 뒤에 붙은\n적 좀 처리해 줘!"
   },
   {
    "name": "0000_0310904",
    "ko": "으아아…\n당하겠어~!"
   },
   {
    "name": "0000_0320902",
    "ko": "미안하다, 폭스!"
   },
   {
    "name": "0000_0330902",
    "ko": "아까의 답례다\n받아 둬!"
   },
   {
    "name": "0000_0330903",
    "ko": "도와준 답례야."
   },
   {
    "name": "0000_0330904",
    "ko": "이건 작은 답례야!"
   },
   {
    "name": "0000_0340002",
    "ko": "폭스!\n뭐 하는 거야!"
   },
   {
    "name": "0000_0340003",
    "ko": "폭스\n농땡이 치고 있네…"
   },
   {
    "name": "0000_0340004",
    "ko": "너무해, 폭스!\n우리한테만 시킬 셈이야?"
   },
   {
    "name": "0000_0340005",
    "ko": "왜 그러냐 폭스!\n작전을 수행해라!"
   },
   {
    "name": "0000_0510001",
    "ko": "알았다!"
   },
   {
    "name": "0000_1000005",
    "ko": "폭스~!!"
   },
   {
    "name": "0000_1010902",
    "ko": "젠장!\n꽁무니를 잡혔어!"
   },
   {
    "name": "0000_1020904",
    "ko": "젠장\n적한테 뒤를 잡혔어~"
   },
   {
    "name": "0000_1040902",
    "ko": "미안하다 폭스!\n서둘러 줘!"
   },
   {
    "name": "0000_1050902",
    "ko": "출력이 안 올라가!\n떼어낼 수가 없어!"
   },
   {
    "name": "0000_1060904",
    "ko": "서둘러 폭스!\n당하겠어~!"
   },
   {
    "name": "0000_1070904",
    "ko": "안 돼!\n못 떼어내겠어~!"
   },
   {
    "name": "0000_1100902",
    "ko": "젠장! 내가…!"
   },
   {
    "name": "0000_1110902",
    "ko": "크악!!\n이대로는 못 버텨!"
   },
   {
    "name": "0000_1120902",
    "ko": "크아악!\n폭스~!!"
   },
   {
    "name": "0000_1130904",
    "ko": "아얏!\n그만 좀 해!"
   },
   {
    "name": "0000_1140904",
    "ko": "아~ 아윙이!!\n격추당하겠어!"
   },
   {
    "name": "0000_1150904",
    "ko": "으아악! 폭스!\n폭스~!!"
   },
   {
    "name": "0000_1220904",
    "ko": "방심했어\n고마워, 폭스!"
   },
   {
    "name": "0000_1280902",
    "ko": "젠장, 여기까진가!\n이탈한다!"
   },
   {
    "name": "0000_1290904",
    "ko": "이런 녀석한테\n당하다니~!!"
   },
   {
    "name": "0000_1310002",
    "ko": "괜찮냐, 폭스!\n당하면 안 된다!"
   },
   {
    "name": "0000_1320002",
    "ko": "꽤 당했구나.\n폭스, 괜찮냐?"
   },
   {
    "name": "0000_1330004",
    "ko": "그 체력으로 괜찮겠어?\n폭스~…"
   },
   {
    "name": "0000_1340004",
    "ko": "폭스가\n당하겠어~"
   },
   {
    "name": "0000_1350003",
    "ko": "폭스, 정신 차려!\n포기하지 마!"
   },
   {
    "name": "0000_1360003",
    "ko": "지지 마, 폭스!\n같이 살아남는 거야!"
   },
   {
    "name": "0000_1370005",
    "ko": "포기하지 마라, 폭스!\n너는 지지 않는다!"
   },
   {
    "name": "0000_1380005",
    "ko": "체력을 생각해서 움직여라!\n질 수는 없다!"
   },
   {
    "name": "0000_2080005",
    "ko": "적이 뒤에 있다!"
   },
   {
    "name": "0000_2090004",
    "ko": "폭스!\n뒤에서 적이 와!"
   },
   {
    "name": "0000_2100002",
    "ko": "폭스!\n뒤에서 노리고 있다고."
   },
   {
    "name": "0000_2110003",
    "ko": "뒤에 적이 붙었어.\n조심해, 폭스."
   },
   {
    "name": "0000_2210005",
    "ko": "공중제비를 써라!\n{6018:11}↑"
   },
   {
    "name": "0000_3160001",
    "ko": "전원 무사 확인!\n지금부터 본성 내부로 돌입한다."
   },
   {
    "name": "0000_3170005",
    "ko": "보급 물자는 받았지?\n고비다, 다들!"
   },
   {
    "name": "0000_3390001",
    "ko": "전원 무사 확인\n페피, 바로 보급이다!"
   },
   {
    "name": "0000_3400005",
    "ko": "물자는 전송하마\n방심하지 마라, 다들!"
   },
   {
    "name": "0000_3620001",
    "ko": "전원 무사 확인\n다음은 드디어 마더다!"
   },
   {
    "name": "0000_3630005",
    "ko": "물자는 전송하마\n힘내라, 다들!"
   },
   {
    "name": "0000_3850001",
    "ko": "우선 태세를 정비한다\n전원 아윙을 갈아타라!"
   },
   {
    "name": "0000_3860005",
    "ko": "이 앞은 너희뿐이다\n충분히 주의해라."
   },
   {
    "name": "0000_4080001",
    "ko": "다들 좀 더 신중해져야 해\n이 앞은 아윙 보급이 안 된다!"
   },
   {
    "name": "0000_4090005",
    "ko": "무사하길 빌고 있으마, 다들!"
   },
   {
    "name": "0000_5010002",
    "ko": "내 실력을 믿으라고\n폭스!"
   },
   {
    "name": "0000_5010003",
    "ko": "고마워, 폭스!\n그래도 이쪽은 괜찮아!"
   },
   {
    "name": "0000_5010004",
    "ko": "이쪽은 순조로워!\n폭스!"
   },
   {
    "name": "0000_5020003",
    "ko": "걱정 안 해도 제대로\n하고 있어, 폭스."
   },
   {
    "name": "0000_5040002",
    "ko": "미안하다!\n은혜는 잊지 않을게!"
   },
   {
    "name": "0000_5040003",
    "ko": "폭스!\n도우러 와 줬구나!"
   },
   {
    "name": "0000_5040004",
    "ko": "폭스!\n도우러 와 줬구나!"
   },
   {
    "name": "0000_5050002",
    "ko": "미안하다, 폭스\n지원을 요청한다!"
   },
   {
    "name": "0000_6040002",
    "ko": "아직 더 갈 수 있어."
   },
   {
    "name": "0361_2000005",
    "ko": "폭스!\n뒤에 적이다!"
   },
   {
    "name": "0361_2010005",
    "ko": "뒤다! 폭스!"
   },
   {
    "name": "0361_2020002",
    "ko": "폭스!\n뒤를 잡혔어!"
   },
   {
    "name": "0361_2030002",
    "ko": "폭스! 뒤다!"
   },
   {
    "name": "0361_2040003",
    "ko": "뒤에 적이 있어\n폭스!"
   },
   {
    "name": "0361_2050003",
    "ko": "폭스!\n뒤야!"
   },
   {
    "name": "0361_2060004",
    "ko": "위험해, 폭스!\n뒤에 적이 있어."
   },
   {
    "name": "0361_2070004",
    "ko": "폭스! 뒤!"
   },
   {
    "name": "0661_0110001",
    "ko": "팩토리를 파괴했다!"
   },
   {
    "name": "0661_0120005",
    "ko": "좋다, 폭스! 남은\n팩토리는 1개다."
   },
   {
    "name": "0661_0130005",
    "ko": "좋다, 폭스! 남은\n팩토리는 2개다."
   },
   {
    "name": "0661_0140005",
    "ko": "좋다, 폭스! 남은\n팩토리는 3개다."
   },
   {
    "name": "0661_0710020",
    "ko": "팩토리 파괴를\n확인했습니다."
   },
   {
    "name": "0661_0880005",
    "ko": "상황을 보고 랜드마스터와\n아윙을 골라 써라."
   },
   {
    "name": "0661_0890003",
    "ko": "좋아! 쓰러뜨렸어!"
   },
   {
    "name": "0661_0950003",
    "ko": "괜찮아!?\n폭스."
   },
   {
    "name": "0800_0020004",
    "ko": "적기 격추!"
   },
   {
    "name": "0800_0030002",
    "ko": "적기 격추!"
   },
   {
    "name": "0961_0010002",
    "ko": "자, 얼른 적 본성으로\n돌격하자고!"
   },
   {
    "name": "0961_0020003",
    "ko": "실드 해제 조건은\n모든 팩토리 파괴구나!"
   },
   {
    "name": "0961_0030005",
    "ko": "적 방어 태세가 갖춰지기 전에\n단숨에 결판을 내라!"
   },
   {
    "name": "0961_0180003",
    "ko": "이 기지… 정말 복잡한\n구조네!"
   },
   {
    "name": "0961_0190001",
    "ko": "여기서 떨어지면 끝이야.\n조심해, 크리스탈!"
   },
   {
    "name": "0961_0200020",
    "ko": "센서에 새로운 반응\n팩토리입니다."
   },
   {
    "name": "0961_0210001",
    "ko": "뭐라고!"
   },
   {
    "name": "0961_0220020",
    "ko": "새로운 팩토리는\n기지 아래쪽에 있습니다."
   },
   {
    "name": "0961_0240001",
    "ko": "뭐!? 공격이\n안 통하는 건가!?"
   },
   {
    "name": "0961_0250005",
    "ko": "근처에 보호 장치가\n있을 거다."
   },
   {
    "name": "0961_0320002",
    "ko": "헷, 여유롭잖아!\n안 그래, 폭스!"
   },
   {
    "name": "0961_0330002",
    "ko": "별거 아니군!\n나 혼자서도 할 수 있어!"
   },
   {
    "name": "0961_0340002",
    "ko": "공중전이라면 자신 있지.\n이쪽은 맡겨 둬!"
   },
   {
    "name": "0961_0350002",
    "ko": "아무리 적 본성이라지만\n꼴사납군… 미안하다."
   },
   {
    "name": "0961_0380003",
    "ko": "폭스, 같이\n살아서 돌아가자."
   },
   {
    "name": "0961_0390003",
    "ko": "이쪽은 괜찮아. 적도\n기습에 당황한 걸까."
   },
   {
    "name": "0961_0400003",
    "ko": "아파로이드도 진심이네!\n조심해, 폭스!"
   },
   {
    "name": "0961_0410003",
    "ko": "여기 녀석들 정말 강해.\n힘을 합쳐야 이길 수 있어!"
   },
   {
    "name": "0961_0440004",
    "ko": "나도 실력은\n늘었다고. 맡겨 둬."
   },
   {
    "name": "0961_0450004",
    "ko": "기지 상공에서 작전 중\n지금은 문제없어."
   },
   {
    "name": "0961_0460004",
    "ko": "이쪽은 괜찮으니까\n기지 쪽에서 힘내!"
   },
   {
    "name": "0961_0470004",
    "ko": "젠장, 여기까지 와서\n당할 수는 없어!"
   },
   {
    "name": "0961_0560001",
    "ko": "여기는 폭스!\n타깃을 전부 파괴!"
   },
   {
    "name": "0961_0570005",
    "ko": "잘했다, 폭스!\n이제 내부로 돌입할 수 있다!"
   },
   {
    "name": "0961_0580002",
    "ko": "상공의 적은 나와\n슬리피가 맡는다!"
   },
   {
    "name": "0961_0590005",
    "ko": "여기가 고비다.\n다들, 부탁한다!"
   },
   {
    "name": "0961_0610005",
    "ko": "남은 것도 얼마 없다.\n부탁한다, 폭스!"
   },
   {
    "name": "0961_0620005",
    "ko": "좋~아! 잘했다!"
   },
   {
    "name": "0961_0630005",
    "ko": "잘했다! 다음\n타깃으로 향해 줘."
   },
   {
    "name": "0961_0640005",
    "ko": "그 녀석을 찾아서\n처리하는 게 먼저다!"
   },
   {
    "name": "0961_0700005",
    "ko": "거기서 격추되면\n그걸로 끝장이다!"
   },
   {
    "name": "0961_0790005",
    "ko": "녀석들의 본거지다.\n신중하게 가라, 폭스."
   },
   {
    "name": "0961_0810004",
    "ko": "나도 할 때는\n한다고~!!"
   },
   {
    "name": "0961_0820003",
    "ko": "괜찮아. 아직 더 할 수 있어."
   },
   {
    "name": "0961_0830003",
    "ko": "이런 곳에서\n당할 수는 없어."
   },
   {
    "name": "0961_0840003",
    "ko": "난 신경 쓰지 마.\n타깃 파괴가 먼저야!"
   },
   {
    "name": "0961_0860002",
    "ko": "이런 곳에서 당할\n수는 없잖아!"
   },
   {
    "name": "0961_0880003",
    "ko": "폭스, 정신 차려!\n넌 리더야!"
   },
   {
    "name": "0961_0900004",
    "ko": "역시 적 본성이야…\n공격이 장난 아니네."
   },
   {
    "name": "0961_0910005",
    "ko": "조심해라, 폭스\n거기서는 탈출할 수 없다!"
   },
   {
    "name": "0961_0920005",
    "ko": "아마 보호 장치가\n지켜 주고 있을 거다."
   },
   {
    "name": "0961_0930003",
    "ko": "여기는 크리스탈\n작전 수행 중."
   },
   {
    "name": "0961_0940003",
    "ko": "여기는 크리스탈\n다들 살아 있지!"
   },
   {
    "name": "0961_0960003",
    "ko": "방심하지 말고 가자\n폭스."
   },
   {
    "name": "0961_0970003",
    "ko": "팩토리를 파괴해서\n실드를 해제해야 해."
   },
   {
    "name": "0961_0990005",
    "ko": "폭스!\n어서 파괴하러 가 줘!"
   },
   {
    "name": "0961_1000005",
    "ko": "팩토리는 지금 있는\n기지 바로 아래에 있다."
   },
   {
    "name": "0961_1010005",
    "ko": "아윙으로 파괴해라.\n부탁한다, 폭스!"
   },
   {
    "name": "0961_1020005",
    "ko": "이번이야말로 마지막이다!\n힘내라, 폭스!"
   },
   {
    "name": "0961_1030005",
    "ko": "방심하지 마라!\n앞으로 2개다!"
   },
   {
    "name": "0961_1040005",
    "ko": "타깃은 앞으로 3개\n폭스! 부탁한다!"
   },
   {
    "name": "0961_1050005",
    "ko": "타깃은 아래다!\n서둘러라, 폭스!"
   },
   {
    "name": "0961_1060003",
    "ko": "폭스!\n어서 팩토리를!"
   },
   {
    "name": "0961_1070003",
    "ko": "이쪽은 괜찮아!\n어서 아윙에 타!"
   },
   {
    "name": "0961_1080002",
    "ko": "포대를 조심해!\n폭스!"
   },
   {
    "name": "0961_1090002",
    "ko": "난 신경 쓰지 마!\n타깃 파괴가 먼저다!"
   },
   {
    "name": "0961_1100004",
    "ko": "이번엔 저런 곳에\n팩토리가 있다니."
   },
   {
    "name": "0961_1110004",
    "ko": "팩토리를 파괴해서\n실드를 해제해야 해."
   },
   {
    "name": "0961_1200004",
    "ko": "뭐랄까\n대단한 곳이네~"
   },
   {
    "name": "0961_1210004",
    "ko": "대체 어떤\n기술을 쓰는 걸까."
   },
   {
    "name": "0961_1220005",
    "ko": "기술이라기보다는\n생물 조직에 가깝군."
   },
   {
    "name": "0961_1230005",
    "ko": "이 기지조차 아마\n마더의 일부라는 거다."
   },
   {
    "name": "0961_1240002",
    "ko": "이런이런\n눈이 어른거리는군."
   },
   {
    "name": "0961_1250002",
    "ko": "아파로이드랑은 취향이\n안 맞을 것 같아."
   },
   {
    "name": "0961_1260003",
    "ko": "저 아래… 별의 중심에서\n강렬한 사념이 느껴져…"
   },
   {
    "name": "0961_1270001",
    "ko": "마더인가…"
   },
   {
    "name": "0961_1280003",
    "ko": "왠지 마음 깊은 곳이\n바싹 마를 것 같아…"
   },
   {
    "name": "0961_1290003",
    "ko": "기분 나빠…"
   },
   {
    "name": "0961_1300005",
    "ko": "다들\n각지의 전황이 들어왔다."
   },
   {
    "name": "0961_1310005",
    "ko": "음… 선전하고 있다고는\n못 하겠군."
   },
   {
    "name": "0961_1320005",
    "ko": "함대의 20%가 괴멸하거나\n철수할 수밖에 없었다."
   },
   {
    "name": "0961_1330005",
    "ko": "다들, 무슨 일이 있어도\n돌파구를 연다!"
   },
   {
    "name": "0961_1340005",
    "ko": "젠장!\n또 철수 소식인가!"
   },
   {
    "name": "0961_1350005",
    "ko": "라일라트계의 희망을\n사라지게 할 수는 없다."
   },
   {
    "name": "0961_1360001",
    "ko": "알고 있어, 페피!"
   },
   {
    "name": "0961_1370005",
    "ko": "크윽!"
   },
   {
    "name": "0961_1380001",
    "ko": "왜 그래, 페피?"
   },
   {
    "name": "0961_1390005",
    "ko": "그레이트폭스에 몇 마리\n달라붙은 모양이다!"
   },
   {
    "name": "0961_1400005",
    "ko": "괜찮다… 나우스!\n실드 레벨을 올려라!"
   },
   {
    "name": "0961_1410001",
    "ko": "무리는 하지 마!"
   },
   {
    "name": "0961_1420005",
    "ko": "팩토리는\n저 건물 안에 있는 모양이다."
   },
   {
    "name": "0961_1430004",
    "ko": "…왠지 괴물\n배 속에 들어가는 것 같아."
   },
   {
    "name": "0961_1440005",
    "ko": "재수 없는 소리 하지 마라\n…라고 하고 싶다만……"
   },
   {
    "name": "0961_1450001",
    "ko": "틀린 말도\n아니라는 거군."
   },
   {
    "name": "0961_1480002",
    "ko": "어릴 때 비슷한\n이야기가 있었지."
   },
   {
    "name": "0961_1490002",
    "ko": "괴물 소굴에 보물을\n찾으러 가는 용사님 얘기지."
   },
   {
    "name": "0961_1500001",
    "ko": "그래서, 용사님은?"
   },
   {
    "name": "0961_1510002",
    "ko": "보물은 손에 넣었지만\n저주로 자기가 괴물로…"
   },
   {
    "name": "0961_1520001",
    "ko": "…그런 얘긴 좀 참아라."
   },
   {
    "name": "0961_1550003",
    "ko": "이런 우주 끝에서\n목숨을 건 싸움이라니…"
   },
   {
    "name": "0961_1560001",
    "ko": "갑자기 심각해졌네.\n왜 그래, 크리스탈?"
   },
   {
    "name": "0961_1570003",
    "ko": "아니, 그냥."
   },
   {
    "name": "0961_1580003",
    "ko": "꼭 무사히 돌아가자\n폭스, 다들!"
   },
   {
    "name": "0961_1610004",
    "ko": "폭스, 길은 제대로\n기억하고 있어?"
   },
   {
    "name": "0961_1620004",
    "ko": "돌아가는 길 헤매지 않게\n조심해~"
   },
   {
    "name": "0961_1630004",
    "ko": "이 기지 말이야\n보기에 따라서는…"
   },
   {
    "name": "0961_1640004",
    "ko": "왠지\n맛있어 보이지~"
   },
   {
    "name": "0961_1650005",
    "ko": "너무 태평하구나\n슬리피!"
   },
   {
    "name": "0961_1660004",
    "ko": "지원하고 싶은데\n여기서는 안 보여."
   },
   {
    "name": "0961_1670004",
    "ko": "창문 정도는 만들어 둬…\n아파로이드 놈들!"
   },
   {
    "name": "0961_1680002",
    "ko": "여기서는\n그쪽 상황을 알 수 없어."
   },
   {
    "name": "0961_1690002",
    "ko": "도움은 없다!\n스스로 헤쳐 나가, 폭스."
   },
   {
    "name": "0961_1700002",
    "ko": "이래선 끝이 없어…"
   },
   {
    "name": "0961_1710002",
    "ko": "좀처럼 편할 날이\n없구나, 폭스."
   },
   {
    "name": "0961_1720002",
    "ko": "거길 해치우면\n다음은 마더로 직행인가!"
   },
   {
    "name": "0961_1730002",
    "ko": "선물은 안 잊었겠지\n페피!"
   },
   {
    "name": "0961_1740005",
    "ko": "프로그램 폭탄이라면\n아윙에 장전해 뒀다."
   },
   {
    "name": "0961_1750005",
    "ko": "하지만 우선 눈앞의 적을\n전력으로 부숴라!"
   },
   {
    "name": "0961_1760003",
    "ko": "이 기지는 대체\n뭘까…"
   },
   {
    "name": "0961_1770003",
    "ko": "건물 자체에서도\n약한 의지가 느껴져…"
   },
   {
    "name": "0961_1780003",
    "ko": "폭스, 다음에\n저녁 사 줘!"
   },
   {
    "name": "0961_1790001",
    "ko": "뭐, 뭐야, 갑자기?"
   },
   {
    "name": "0961_1800003",
    "ko": "뭐든 좋으니까 약속을\n해 두는 게 좋을 것 같아서."
   },
   {
    "name": "0961_1801003",
    "ko": "그치, 폭스?"
   },
   {
    "name": "0961_1820005",
    "ko": "적의 본거지다. 어느 정도\n저항은 각오해야지."
   },
   {
    "name": "0961_1830004",
    "ko": "바로 아래 구멍이\n으스스해~"
   },
   {
    "name": "0961_1840005",
    "ko": "저 까마득한 안쪽에\n마더가 있을 거다."
   },
   {
    "name": "0961_1850004",
    "ko": "뛰어들고 싶기도 하고\n뛰어들기 싫기도 하고…"
   },
   {
    "name": "0961_1860002",
    "ko": "흥, 끝까지\n즐겁게 해 주겠다는 거냐!"
   },
   {
    "name": "0961_1870002",
    "ko": "폭스\n확실하게 끝내 버려!"
   },
   {
    "name": "0961_1880002",
    "ko": "끝까지 발버둥이군\n아파로이드!"
   },
   {
    "name": "0961_1890005",
    "ko": "아파로이드한테\n죽음 같은 게 있으려나."
   },
   {
    "name": "0961_1900002",
    "ko": "…딴지 걸지 마, 페피."
   },
   {
    "name": "0961_1910003",
    "ko": "질척질척 솟아 나오는\n불쾌한 감각!"
   },
   {
    "name": "0961_1911003",
    "ko": "정신이 아득해질 것 같아…"
   },
   {
    "name": "0961_1920001",
    "ko": "크리스탈!"
   },
   {
    "name": "0961_1930003",
    "ko": "괜찮아. 모두의 마음이\n지켜 주고 있어!"
   },
   {
    "name": "0961_1940003",
    "ko": "바로 아래 구멍에서 마더의\n의지가 솟아오르고 있어…"
   },
   {
    "name": "0961_1950003",
    "ko": "지지 마, 폭스!\n진짜 적은 바로 저기야!!"
   },
   {
    "name": "0961_1960005",
    "ko": "젠장!\n또 통신이 끊겼다!"
   },
   {
    "name": "0961_1970005",
    "ko": "이제 정말 우리가\n마지막 희망일지도 모르겠군…"
   },
   {
    "name": "0961_1980005",
    "ko": "하지만 좌절하지 마라! 누군가\n마더를 쓰러뜨리면…"
   },
   {
    "name": "0961_1990005",
    "ko": "프로그램을 쏘아 넣으면\n모든 게 해방된다!"
   },
   {
    "name": "0961_2000001",
    "ko": "함정인가!?"
   },
   {
    "name": "0961_2000005",
    "ko": "폭스, 팔코\n슬리피, 크리스탈."
   },
   {
    "name": "0961_2010005",
    "ko": "나는 너희와 함께\n싸울 수 있어서 자랑스럽다."
   },
   {
    "name": "0961_2020001",
    "ko": "갑자기 왜 그래\n페피?"
   },
   {
    "name": "0961_2030005",
    "ko": "아무것도 아니다…\n그저 이기라는 말이다."
   },
   {
    "name": "0961_2040001",
    "ko": "…… 알았어, 페피!"
   },
   {
    "name": "0361_1600003",
    "ko": "꽤 당했네.\n폭스답지 않아."
   },
   {
    "name": "0361_1620004",
    "ko": "힘들어 보이네, 폭스\n괜찮아?"
   },
   {
    "name": "0661_1210002",
    "ko": "꼴이 그게 뭐냐!\n정신 차려! 폭스!"
   },
   {
    "name": "0661_1130003",
    "ko": "폭스\n상태는 어때?"
   },
   {
    "name": "0000_2350005",
    "ko": "평행 이동을 잘 써라!\n{6030:0} 누르면서 ←{6018:4}→"
   },
   {
    "name": "0000_1880005",
    "ko": "그 적에게는 머신건이\n안 통한다!!"
   },
   {
    "name": "0000_1890005",
    "ko": "그 적에게는 블래스터가\n안 통한다!!"
   }
  ]
 }
]
