   {
    "name": "0000_0200004",
    "ko": "나야, 폭스~!"
   },
   {
    "name": "0000_0210002",
    "ko": "칫!!\n한 방 먹었다!"
   },
   {
    "name": "0000_0220001",
    "ko": "으아아~!"
   },
   {
    "name": "0000_0220002",
    "ko": "폭스~!!"
   },
   {
    "name": "0000_0220003",
    "ko": "폭스~!!"
   },
   {
    "name": "0000_0220004",
    "ko": "폭스~!!"
   },
   {
    "name": "0000_0240002",
