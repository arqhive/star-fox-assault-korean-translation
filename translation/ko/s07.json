[
 {
  "path": [
   "c30",
   "0",
   "c1",
   "0",
   "1"
  ],
  "first": "0721_0010001",
  "entries": [
   {
    "name": "0721_0010001",
    "ko": "여기가 코네리아라고…?"
   },
   {
    "name": "0721_0020001",
    "ko": "여기는 폭스\n지금부터 방해 장치 파괴에 나선다."
   },
   {
    "name": "0721_0030005",
    "ko": "적의 수가 많다. 무리하게 쓰러뜨리지 말고\n확실하게 방해 장치 파괴를 노려라."
   },
   {
    "name": "0721_0040001",
    "ko": "알았다."
   }
  ]
 },
 {
  "path": [
   "c31",
   "0",
   "c1",
   "0",
   "1"
  ],
  "first": "0731_1000001",
  "entries": [
   {
    "name": "0731_1000001",
    "ko": "으악!"
   },
   {
    "name": "0433_0100001",
    "ko": "뭣!?"
   },
   {
    "name": "0731_0050001",
    "ko": "…으…… 큭…"
   },
   {
    "name": "0731_0040001",
    "ko": "방심했나…"
   },
   {
    "name": "0731_0060008",
    "ko": "꼴좋구나! 폭스!"
   },
   {
    "name": "0731_0070001",
    "ko": "…!!"
   },
   {
    "name": "0731_0080001",
    "ko": "울펜! 울프냐!?"
   },
   {
    "name": "0731_0090001",
    "ko": "큭!"
   },
   {
    "name": "0731_1010001",
    "ko": "으아아아아아악~!"
   },
   {
    "name": "0731_0100001",
    "ko": "울프… 무슨 속셈이야?"
   },
   {
    "name": "0731_0110008",
    "ko": "네가 멋대로 떨어진 거잖아."
   },
   {
    "name": "0731_0120008",
    "ko": "우리는 기계 놈들한테\n빚을 갚으러 왔을 뿐이다."
   },
   {
    "name": "0731_0130009",
    "ko": "그런 거지."
   },
   {
    "name": "0731_0140010",
    "ko": "…흥"
   },
   {
    "name": "0731_0150001",
    "ko": "울프…"
   },
   {
    "name": "0731_0160008",
    "ko": "얼빠진 낯짝 하지 마라!"
   },
   {
    "name": "0731_0170008",
    "ko": "이대로 간다!!"
   }
  ]
 },
 {
  "path": [
   "c32",
   "0",
   "c1",
   "0",
   "1"
  ],
  "first": "0732_1000020",
  "entries": [
   {
    "name": "0732_1000020",
    "ko": "소속 불명의 비행체가\n고속으로 접근 중입니다."
   },
   {
    "name": "0732_1010001",
    "ko": "새로운 적인가!?"
   },
   {
    "name": "0732_1020005",
    "ko": "기다려… 저 기체는…"
   },
   {
    "name": "0732_1030005",
    "ko": "장군 전용기……!?"
   },
   {
    "name": "0732_0050006",
    "ko": "… 폭스인가…\n이제 틀렸네…… 아파로이드가…"
   },
   {
    "name": "0732_1040001",
    "ko": "장군!? 설마!!"
   },
   {
    "name": "0732_1050006",
    "ko": "방심했네…\n이제 내 몸은 뜻대로 되지 않네…"
   },
   {
    "name": "0732_1060001",
    "ko": "……!!"
   },
   {
    "name": "0732_1070006",
    "ko": "마지막 부탁이네…\n이 기체를… 나를 파괴하게!"
   },
   {
    "name": "0732_1080001",
    "ko": "말도 안 돼! 그런 짓을!!"
   },
   {
    "name": "0732_1090006",
    "ko": "나에게 침략자의 앞잡이 노릇을\n시킬 셈인가, 폭스!!"
   },
   {
    "name": "0732_0080008",
    "ko": "그런 거다.\n포기해라, 폭스."
   },
   {
    "name": "0732_1120001",
    "ko": "…… 이럴 수가…\n이럴 수가…!"
   },
   {
    "name": "0732_1110001",
    "ko": "젠자아아아아앙!!!"
   }
  ]
 },
 {
  "path": [
   "c33",
   "0",
   "c1",
   "0",
   "1"
  ],
  "first": "0741_1000005",
  "entries": [
   {
    "name": "0741_1000005",
    "ko": "페퍼 장군~!!"
   },
   {
    "name": "0741_1010001",
    "ko": "페피!!"
   },
   {
    "name": "0741_1020005",
    "ko": "장군…… 무사하십니까……?"
   },
   {
    "name": "0741_1030006",
    "ko": "페피인가…… 무모한 짓을…"
   },
   {
    "name": "0741_1040005",
    "ko": "하하하… 좀처럼 은퇴는\n못 하겠군요… 아야야!"
   },
   {
    "name": "0741_1050001",
    "ko": "페피……"
   },
   {
    "name": "0741_1060005",
    "ko": "의료반에 연락해 주게.\n…어찌어찌 임무 완료로구먼."
   },
   {
    "name": "0741_0040001",
    "ko": "울프, 덕분에 목숨을 건졌어.\n고맙다."
   },
   {
    "name": "0741_0050008",
    "ko": "말했을 텐데\n도우러 온 게 아니라고."
   },
   {
    "name": "0741_0060001",
    "ko": "그래도… 말이야."
   },
   {
    "name": "0741_0070008",
    "ko": "흥"
   },
   {
    "name": "0741_0080008",
    "ko": "그나저나\n언제까지 올라타 있을 셈이냐."
   },
   {
    "name": "0741_0090001",
    "ko": "아, 아아…"
   },
   {
    "name": "0741_0100008",
    "ko": "폭스"
   },
   {
    "name": "0741_0110008",
    "ko": "딱 하나만 충고해 주지."
   },
   {
    "name": "0741_0120008",
    "ko": "망설이지 마라!\n여차할 땐 주저 없이 행동해라!"
   },
   {
    "name": "0741_1070001",
    "ko": "울프…"
   }
  ]
 },
