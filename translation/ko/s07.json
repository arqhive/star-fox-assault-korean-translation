 {
  "path": [
   "c47",
   "0",
   "1"
  ],
  "first": "0000_0200002",
  "entries": [
   {
    "name": "0000_0200002",
    "ko": "큭! 적과 아군도\n구별 못 하냐!"
   },
   {
    "name": "0000_0200003",
    "ko": "잠깐!\n장난은 그만해!"
   },
   {
    "name": "0000_0200004",
    "ko": "나야, 폭스~!"
   },
   {
    "name": "0000_0200008",
    "ko": "네 이놈! 해보자는 거냐!"
   },
   {
    "name": "0000_0200009",
    "ko": "여우! 죽고 싶냐!"
   },
   {
    "name": "0000_0200010",
    "ko": "네놈도 농담을 좋아하는군."
   },
   {
    "name": "0000_0210903",
    "ko": "내가 당하다니!!"
   },
   {
    "name": "0000_0220001",
    "ko": "으아아~!"
   },
   {
    "name": "0000_0220002",
    "ko": "폭스~!!"
   },
   {
    "name": "0000_0220003",
    "ko": "폭스~!!"
   },
   {
    "name": "0000_0220004",
    "ko": "폭스~!!"
   },
   {
    "name": "0000_0230904",
    "ko": "으악, 이제 안 돼~\n먼저 이탈할게!"
   },
   {
    "name": "0000_0240002",
    "ko": "내 사냥감에 손대지 마\n폭스!!"
   },
   {
    "name": "0000_0240003",
    "ko": "잠깐! 내 사냥감이야!"
   },
   {
    "name": "0000_0240004",
    "ko": "앗! 내가\n노리고 있었는데!"
   },
   {
    "name": "0000_0240008",
    "ko": "이 몸의 사냥감인 줄\n알고 한 짓이냐?"
   },
   {
    "name": "0000_0240009",
    "ko": "핫, 사냥감을 가로채다니\n매너도 모르는군."
   },
   {
    "name": "0000_0240010",
    "ko": "장난질을!!\n내 사냥감이다!"
   },
   {
    "name": "0000_0250002",
    "ko": "방해다, 비켜!"
   },
   {
    "name": "0000_0250003",
    "ko": "정신 차려\n폭스!"
   },
   {
    "name": "0000_0250004",
    "ko": "으악\n너무해, 폭스!"
   },
   {
    "name": "0000_0250008",
    "ko": "정신 똑바로 차려!!"
   },
   {
    "name": "0000_0250009",
    "ko": "어딜 보고 있는 거냐!"
   },
   {
    "name": "0000_0250010",
    "ko": "방해된다고!!\n꼬맹이."
   },
   {
    "name": "0000_0260002",
    "ko": "괜찮냐\n폭스!"
   },
   {
    "name": "0000_0260003",
    "ko": "괜찮아!? 폭스!"
   },
   {
    "name": "0000_0260004",
    "ko": "괜찮아!?\n폭스!"
   },
   {
    "name": "0000_0260008",
    "ko": "어이어이… 꼴이 그게 뭐냐."
   },
   {
    "name": "0000_0260009",
    "ko": "정말이지, 한심하군."
   },
   {
    "name": "0000_0260010",
    "ko": "흥, 결국 여우는\n이 정도인가?"
   },
   {
    "name": "0000_0270002",
    "ko": "컨디션이 안 좋아 보이는데\n폭스."
   },
   {
    "name": "0000_0270003",
    "ko": "폭스\n힘내!!"
   },
   {
    "name": "0000_0270004",
    "ko": "폭스가 저러는 건\n못 보겠어~"
   },
   {
    "name": "0000_0270008",
    "ko": "괜찮냐?\n너덜너덜하잖아."
   },
   {
    "name": "0000_0270009",
    "ko": "어이어이, 들은 얘기랑\n영 딴판인데…"
   },
   {
    "name": "0000_0270010",
    "ko": "약하다. 너무 약해…"
   },
   {
    "name": "0000_0300903",
    "ko": "폭스!\n뒤에 붙은 적 좀 부탁해!"
   },
   {
    "name": "0000_0300904",
    "ko": "폭스! 뒤에 붙은 적 좀\n어떻게 해 줘~"
   },
   {
    "name": "0000_0310903",
    "ko": "폭스! 빨리 뒤에 붙은\n적 좀 어떻게 해 줘!!"
   },
   {
    "name": "0000_0310904",
    "ko": "으아아…\n당하겠어~!"
   },
   {
    "name": "0000_0320903",
    "ko": "고마워, 폭스."
   },
   {
    "name": "0000_0340002",
    "ko": "폭스!\n뭐 하는 거야!"
   },
   {
    "name": "0000_0340003",
    "ko": "폭스\n농땡이 치고 있네…"
   },
   {
    "name": "0000_0340004",
    "ko": "너무해, 폭스!\n우리한테만 시킬 셈이야?"
   },
   {
    "name": "0000_0340005",
    "ko": "왜 그러냐 폭스!\n작전을 수행해라!"
   },
   {
    "name": "0000_1000005",
    "ko": "폭스~!!"
   },
   {
    "name": "0000_1030903",
    "ko": "정말, 오지 마!\n폭스, 뒤의 적 좀 부탁해!"
   },
   {
    "name": "0000_1060904",
    "ko": "서둘러 폭스!\n당하겠어~!"
   },
   {
    "name": "0000_1070904",
    "ko": "안 돼!\n못 떼어내겠어~!"
   },
   {
    "name": "0000_1080903",
    "ko": "부탁해 폭스!\n빨리 와 줘!"
   },
   {
    "name": "0000_1090903",
    "ko": "말도 안 돼!\n떼어낼 수가 없다니!"
   },
   {
    "name": "0000_1140904",
    "ko": "아~ 아윙이!!\n격추당하겠어!"
   },
   {
    "name": "0000_1150904",
    "ko": "으아악! 폭스!\n폭스~!!"
   },
   {
    "name": "0000_1160903",
    "ko": "큭! 맞았어!"
   },
   {
    "name": "0000_1170903",
    "ko": "위험해\n이대로는…!"
   },
   {
    "name": "0000_1180903",
    "ko": "꺄아악!\n폭스~!!"
   },
   {
    "name": "0000_1210904",
    "ko": "위험했다~\n살았어, 폭스!"
   },
   {
    "name": "0000_1300903",
    "ko": "미안! 난 여기까지야\n전선에서 이탈할게."
   },
   {
    "name": "0000_1310002",
    "ko": "괜찮냐, 폭스!\n당하면 안 된다!"
   },
   {
    "name": "0000_1320002",
    "ko": "꽤 당했구나.\n폭스, 괜찮냐?"
   },
   {
    "name": "0000_1330004",
    "ko": "그 체력으로 괜찮겠어?\n폭스~…"
   },
   {
    "name": "0000_1340004",
    "ko": "폭스가\n당하겠어~"
   },
   {
    "name": "0000_1350003",
    "ko": "폭스, 정신 차려!\n포기하지 마!"
   },
   {
    "name": "0000_1360003",
    "ko": "지지 마, 폭스!\n같이 살아남는 거야!"
   },
   {
    "name": "0000_1370005",
    "ko": "포기하지 마라, 폭스!\n너는 지지 않는다!"
   },
   {
    "name": "0000_1380005",
    "ko": "체력을 생각해서 움직여라!\n질 수는 없다!"
   },
   {
    "name": "0000_2080005",
    "ko": "적이 뒤에 있다!"
   },
   {
    "name": "0000_2090004",
    "ko": "폭스!\n뒤에서 적이 와!"
   },
   {
    "name": "0000_2100002",
    "ko": "폭스!\n뒤에서 노리고 있다고."
   },
   {
    "name": "0000_2110003",
    "ko": "뒤에 적이 붙었어.\n조심해, 폭스."
   },
   {
    "name": "0000_3120001",
    "ko": "전 기체 귀환!\n페피, 몸은 좀 어때?"
   },
   {
    "name": "0000_3130005",
    "ko": "그럭저럭이다\n장군은 병원에서 치료 중이야."
   },
   {
    "name": "0000_3350001",
    "ko": "전 기체 귀환\n페피… 무모한 짓을…!"
   },
   {
    "name": "0000_3360005",
    "ko": "하하하……\n뭐, 결과만 좋으면 됐지."
   },
   {
    "name": "0000_3580001",
    "ko": "전 기체 귀환\n누구 한 명 빼고 말이지."
   },
   {
    "name": "0000_3590005",
    "ko": "하하하……\n뭐, 이런 일도 있는 법이지."
   },
   {
    "name": "0000_3810001",
    "ko": "정말이지…\n다들 너덜너덜하군…"
   },
   {
    "name": "0000_3820004",
    "ko": "울프 일당이 와 줘서 살았어~"
   },
   {
    "name": "0000_4040001",
    "ko": "코네리아 시티는 해방한 것 같은데…"
   },
   {
    "name": "0000_4050002",
    "ko": "대가가 꽤 컸다고… 아야야…"
   },
   {
    "name": "0000_6070003",
    "ko": "조금 아팠을지도."
   },
   {
    "name": "0761_0020005",
    "ko": "하나도 남김없이 방해 장치를\n부숴라!"
   },
   {
    "name": "0761_0030001",
    "ko": "알고 있어, 페피\n전멸시켜 주지!"
   },
   {
    "name": "0761_0040005",
    "ko": "그걸 쓰러뜨리지 않으면\n레이더를 쓸 수 없다!"
   },
   {
    "name": "0761_0060005",
    "ko": "건물 뒤에 있는 적도\n조심해라!!"
   },
   {
    "name": "0761_0070005",
    "ko": "폭스! 되도록\n무기를 챙겨서 싸워라!!"
   },
   {
    "name": "0761_0080005",
    "ko": "폭스, 뒤에서 오는\n적도 조심해라!"
   },
   {
    "name": "0761_0090005",
    "ko": "좋다! 폭스!\n나머지도 부탁한다!"
   },
   {
    "name": "0761_0100003",
    "ko": "폭스! 레이더도\n꽤 회복되고 있어."
   },
   {
    "name": "0761_0250001",
    "ko": "저게 방해 장치인가!"
   },
   {
    "name": "0761_0270005",
    "ko": "먼 적에게는 저격총을\n써라!"
   },
   {
    "name": "0761_0290002",
    "ko": "폭스\n지상에서 안 보이냐?"
   },
   {
    "name": "0761_0300005",
    "ko": "저격총이라면\n먼 곳도 확인할 수 있다."
   },
   {
    "name": "0761_0310003",
    "ko": "…! 그게 방해 장치야!"
   },
   {
    "name": "0761_0340005",
    "ko": "폭스! 지상에서라면\n확실히 노릴 수 있을 거다."
   },
   {
    "name": "0761_0360004",
    "ko": "이런 쓸모없는 레이더로\n어쩌라는 거야~"
   },
   {
    "name": "0761_0370003",
    "ko": "레이더로 안 보이는 곳에야말로\n뭔가 있지 않을까?"
   },
   {
    "name": "0761_0380004",
    "ko": "앗, 그렇구나!\n크리스탈, 예리해~"
   },
   {
    "name": "0761_0390003",
    "ko": "방해 장치를 파괴하면\n레이더가 회복되나 봐."
   },
   {
    "name": "0761_0400005",
    "ko": "언제까지 버틸지 모른다.\n서둘러라! 폭스!"
   },
   {
    "name": "0761_0410005",
    "ko": "좋다! 폭스!\n그 기세다!"
   },
   {
    "name": "0761_0420005",
    "ko": "좋다! 폭스!\n꽤 처리했구나!"
   },
   {
    "name": "0761_0430005",
    "ko": "좋다! 폭스!\n조금만 더다!"
   },
   {
    "name": "0761_0440002",
    "ko": "제법인데, 폭스\n조금은 다시 봤어!"
   },
   {
    "name": "0761_0450004",
    "ko": "그 기세야~\n폭스~"
   },
   {
    "name": "0761_0460003",
    "ko": "좋아, 폭스\n그 기세야!"
   },
   {
    "name": "0761_0480005",
    "ko": "타깃도 얼마 안 남았다.\n방심하지 마라!"
   },
   {
    "name": "0761_0500001",
    "ko": "이 녀석들, 혹시…"
   },
   {
    "name": "0761_0510002",
    "ko": "아파로이드 놈들!\n어디까지 침식할 셈이냐!"
   },
   {
    "name": "0761_0520002",
    "ko": "이거 심하군…\n도시가 괴멸 상태야."
   },
   {
    "name": "0761_0530002",
    "ko": "더는 적들이 설치게\n둘 수 없어, 폭스."
   },
   {
    "name": "0761_0540003",
    "ko": "레이더를 방해하다니\n녀석들도 고약하네."
   },
   {
    "name": "0761_0550002",
    "ko": "레이더를 방해하다니\n녀석들도 머리를 썼군…"
   },
   {
    "name": "0761_0560003",
    "ko": "지상의 폭스만\n믿을게. 힘내."
   },
   {
    "name": "0761_0570004",
    "ko": "폭스~\n믿고 있을게~"
   },
   {
    "name": "0761_0580004",
    "ko": "그나저나 괜찮을까?\n페퍼 장군"
   },
   {
    "name": "0761_0590002",
    "ko": "여기가 이 꼴이니 말이야…"
   },
   {
    "name": "0761_0600003",
    "ko": "무사하길 빌 수밖에 없겠네…"
   },
   {
    "name": "0761_0610002",
    "ko": "이 녀석들, 어디까지\n먹어 치울 셈이냐!"
   },
   {
    "name": "0761_1100005",
    "ko": "좋다, 폭스!\n이제 레이더를 쓸 수 있겠군."
   },
   {
    "name": "0761_1200005",
    "ko": "아윙을 전송했다!\n레이더를 확인해라!"
   },
   {
    "name": "0761_1300003",
    "ko": "폭스 덕분에\n적 위치를 파악할 수 있어."
   },
   {
    "name": "0761_1400004",
    "ko": "이제 공중의 녀석들을\n싹 쓸어버리자!"
   },
   {
    "name": "0761_1500002",
    "ko": "형세 역전이다!"
   },
   {
    "name": "0761_1500005",
    "ko": "아윙으로 향해라\n폭스!"
   },
   {
    "name": "0761_2000005",
    "ko": "방해 장치는 곳곳에\n숨어 있는 모양이다."
   },
   {
    "name": "0761_2010005",
    "ko": "공격이 안 통하는\n것 같다, 폭스."
   },
   {
    "name": "0761_2020005",
    "ko": "저격총으로\n녀석의 약점을 찾아라!"
   },
   {
    "name": "0761_2030004",
    "ko": "폭스!\n실력이 늘었네!"
   },
   {
    "name": "0761_2040002",
    "ko": "공중의 적도\n조심해라!"
   },
   {
    "name": "0762_0010008",
    "ko": "내 소중한 울펜에\n올라타 있는 거다!"
   },
   {
    "name": "0762_0020008",
    "ko": "실망시키지 마라\n폭스."
   },
   {
    "name": "0762_0030009",
    "ko": "이거 좋군. 네가\n울프의 총 대신이라니."
   },
   {
    "name": "0762_0040010",
    "ko": "실수해 봐라. 그땐\n네가 타깃이다."
   },
   {
    "name": "0762_0050008",
    "ko": "적이다, 폭스."
   },
   {
    "name": "0762_0060008",
    "ko": "조금은 근성 있는\n놈들인 것 같군."
   },
   {
    "name": "0762_0070008",
    "ko": "또 이 녀석들인가. 이런\n놈들한테 시간 끌지 마라!"
   },
   {
    "name": "0762_0080008",
    "ko": "꽤 인기가 많은 모양이군…\n적이다, 폭스 씨!"
   },
   {
    "name": "0762_0090008",
    "ko": "딱 붙어서 따라오는군.\n폭스, 뒤는 맡긴다!"
   },
   {
    "name": "0762_0100008",
    "ko": "폭스! 실력이\n떨어진 거 아니냐!"
   },
   {
    "name": "0762_0110008",
    "ko": "흥, 조금은\n나아졌군, 폭스."
   },
   {
    "name": "0762_0120902",
    "ko": "폭스!\n날 쏴서 어쩌자는 거야!"
   },
   {
    "name": "0762_0130008",
    "ko": "네 실력도\n제법이구나!"
   },
   {
    "name": "0762_0140008",
    "ko": "꽤 맞았군…\n하지만 이제부터다!"
   },
   {
    "name": "0762_0150008",
    "ko": "큭, 컨디션이 안 올라와."
   },
   {
    "name": "0762_0160008",
    "ko": "큭, 이렇게 대미지를\n입다니 나도 한물갔군…"
   },
   {
    "name": "0762_0170008",
    "ko": "큭, 나도 한물갔군."
   },
   {
    "name": "0762_0180008",
    "ko": "어딜 노리고\n쏘는 거냐!"
   },
   {
    "name": "0762_0190008",
    "ko": "이 몸의 소중한\n울펜에 무슨 짓이냐."
   },
   {
    "name": "0762_0200008",
    "ko": "여우~~!!\n적당히 좀 해라!!"
   },
   {
    "name": "0762_0210008",
    "ko": "배짱 좋군.\n각오는 됐겠지."
   },
   {
    "name": "0762_0220008",
    "ko": "젠장!!!"
   },
   {
    "name": "0762_0230008",
    "ko": "크윽, 여기까진가…"
   },
   {
    "name": "0762_0240001",
    "ko": "으아아~"
   },
   {
    "name": "0762_0250008",
    "ko": "폭스! 록온해 오는\n놈이 있다."
   },
   {
    "name": "0762_0260008",
    "ko": "큭, 록온당했나!"
   },
   {
    "name": "0762_0270902",
    "ko": "칫! 내가 이런 실수를…"
   },
   {
    "name": "0762_0280902",
    "ko": "폭스!\n뒤에 붙은 적 좀 부탁해!"
   },
   {
    "name": "0762_0290902",
    "ko": "큭!\n떼어낼 수가 없어!!"
   },
   {
    "name": "0762_0300902",
    "ko": "끈질긴 녀석들이군!"
   },
   {
    "name": "0762_0310008",
    "ko": "제법이군\n폭스."
   },
   {
    "name": "0762_0320902",
    "ko": "살았다, 폭스!\n빚이 하나 늘었군."
   },
   {
    "name": "0762_0340902",
    "ko": "미안하다… 폭스\n이탈한다…"
   },
   {
    "name": "0762_0350002",
    "ko": "아까는 미안했다\n폭스."
   },
   {
    "name": "0762_0360010",
    "ko": "정말이지, 대단한\n파트너를 뒀군."
   },
   {
    "name": "0762_0370002",
    "ko": "시끄러워! 너하곤\n언젠가 결판을 내 주지!"
   },
   {
    "name": "0762_0380009",
    "ko": "아~아, 단골\n바가 박살나 버렸네."
   },
   {
    "name": "0762_0391009",
    "ko": "이게 끝나면\n건배나 하고 싶군."
   },
   {
    "name": "0762_0400010",
    "ko": "벌레 놈들… 두려워하지\n않는 적은 재미없어."
   },
   {
    "name": "0762_0420009",
    "ko": "크리스탈\n내 날개에 타지 않겠어?"
   },
   {
    "name": "0762_0430003",
    "ko": "폭스랑 같이라면"
   },
   {
    "name": "0762_0440009",
    "ko": "하하, 이거 두 손 들었군."
   },
   {
    "name": "0762_0450009",
    "ko": "하항, 즐기고 있구먼.\n꽤 쓰러뜨렸잖아."
   },
   {
    "name": "0762_0460010",
    "ko": "흥, 거슬리는 녀석이군.\n내 사냥감이다!"
   },
   {
    "name": "0762_0480004",
    "ko": "출발은 OK인 느낌이네.\n꽤 쓰러뜨리고 있어!"
   },
   {
    "name": "0762_0490003",
    "ko": "우쭐대지 마.\n방심은 금물이야, 폭스."
   },
   {
    "name": "0762_0500009",
    "ko": "컨디션 좋아 보이잖아.\n역시 사랑의 라이벌이군!"
   },
   {
    "name": "0762_0510010",
    "ko": "호오… 새보다는\n나은 것 같군…"
   },
   {
    "name": "0762_0540004",
    "ko": "울프도 꽤 하는데~"
   },
   {
    "name": "0762_0550008",
    "ko": "거슬린다, 개구리."
   },
   {
    "name": "0762_0560003",
    "ko": "믿어도\n될 것 같네…"
   },
   {
    "name": "0762_0570008",
    "ko": "흥"
   },
   {
    "name": "0762_0580009",
    "ko": "멋지네, 형씨!"
   },
   {
    "name": "0762_0590010",
    "ko": "후후후, 다음에 네놈과\n싸울 날이 기대되는군."
   },
   {
    "name": "0762_0600002",
    "ko": "분하지만 꽤\n좋은 콤비다, 너희."
   },
   {
    "name": "0762_0620004",
    "ko": "대단해!\n다음엔 나도 태워 줘~"
   },
   {
    "name": "0762_0630003",
    "ko": "날개 위도 괜찮은 느낌이네."
   },
   {
    "name": "0762_0640009",
    "ko": "그렇게 여유 부릴\n때가 아니지 않아?"
   },
   {
    "name": "0762_0650010",
    "ko": "네놈, 죽고 싶으면\n빨리 나한테 말해."
   },
   {
    "name": "0762_0660008",
    "ko": "칫! 폭스!\n적이 보이냐?!"
   },
   {
    "name": "0762_0670008",
    "ko": "큭! 폭스!\n녀석들이 공격하게 두지 마!"
   },
   {
    "name": "0762_0680008",
    "ko": "칫! 공격을 받고 있다.\n실망시키지 마!"
   },
   {
    "name": "0762_0690008",
    "ko": "젠장, 다 못 피하겠어!!\n폭스, 어떻게 좀 해 봐!"
   },
   {
    "name": "0763_0010006",
    "ko": "몸이 말을 듣지 않네!\n나까지 함께 파괴하게!"
   },
   {
    "name": "0763_0020008",
    "ko": "망설이지 마라, 폭스!\n할 수밖에 없다!!"
   },
   {
    "name": "0763_0030008",
    "ko": "에너지를 모으고 있다.\n공격하게 두지 마!"
   },
   {
    "name": "0763_0040008",
    "ko": "녀석이 에너지를 모으게\n두지 마! 공격당한다!"
   },
   {
    "name": "0763_0060006",
    "ko": "괜찮으니 쏘게!\n폭스!"
   },
   {
    "name": "0763_0070008",
    "ko": "또 에너지를\n모으고 있다!"
   },
   {
    "name": "0763_0090008",
    "ko": "큭! 폭스!\n녀석이 공격하게 두지 마!"
   },
   {
    "name": "0763_0100008",
    "ko": "몇 번이고 맞으면 위험해!\n폭스!"
   },
   {
    "name": "0763_0110008",
    "ko": "폭스, 미사일이다!\n격추해라!"
   },
   {
    "name": "0763_0120008",
    "ko": "또 미사일을\n발사했다!"
   },
   {
    "name": "0763_0130008",
    "ko": "격추해라!\n폭스!"
   },
   {
    "name": "0763_0140008",
    "ko": "폭스, 미사일이다!\n격추해!"
   },
   {
    "name": "0763_0150008",
    "ko": "칫! 제대로\n적의 공격을 보고 있냐!?"
   },
   {
    "name": "0763_0160008",
    "ko": "뭐 하는 거냐!\n미사일을 파괴해라!"
   },
   {
    "name": "0763_0170008",
    "ko": "칫, 뒤를 잡혔나!\n떼어낸다!"
   },
   {
    "name": "0763_0180008",
    "ko": "이 자식! 따라붙었다!\n공격해!"
   },
   {
    "name": "0763_0190006",
    "ko": "안 되네… 어쩔 도리가 없구먼!\n쏘게! 나를 쏘게!!"
   },
   {
    "name": "0763_0200002",
    "ko": "아파로이드 놈들…\n악랄한 짓을 하는군!"
   },
   {
    "name": "0763_0210004",
    "ko": "아파로이드 놈들… 장군한테까지\n달라붙다니~!!"
   },
   {
    "name": "0763_0220003",
    "ko": "이런 일이 벌어지다니…"
   },
   {
    "name": "0763_0230006",
    "ko": "망설일 이유는 없네… 나는\n이미 아파로이드일세…"
   },
   {
    "name": "0763_0240006",
    "ko": "전장에서 스러진다면 그걸로 족하네…\n추한 모습은 보일 수 없네!"
   },
   {
    "name": "0763_0250006",
    "ko": "긍지를… 나의 긍지를\n지켜 주게, 폭스!"
   },
   {
    "name": "0763_0260001",
    "ko": "장군…!!"
   },
   {
    "name": "0763_0270006",
    "ko": "큭…! 내가 자네들과\n싸우게 되다니……!!"
   },
   {
    "name": "0763_0280002",
    "ko": "여기서 네가 당하면\n어쩌자는 거야!!"
   },
   {
    "name": "0763_0290004",
    "ko": "폭스…! 장군…!\n으아, 어떡하면 좋아."
   },
   {
    "name": "0763_0300003",
    "ko": "잠깐, 뭐 하는 거야?\n폭스를 태우고 있잖아."
   },
   {
    "name": "0763_0310008",
    "ko": "어이어이, 대미지 입는\n건 이쪽인데?"
   },
   {
    "name": "0763_0320008",
    "ko": "그 기세다!\n단숨에 가라!"
   },
   {
    "name": "0763_0330004",
    "ko": "어쩔 수 없는 걸까…\n훌쩍, 훌쩍…"
   },
   {
    "name": "0763_0340008",
    "ko": "좋아, 아파로이드도 꽤\n지친 모양이군!"
   },
   {
    "name": "0763_0350003",
    "ko": "페퍼 장군…"
   },
   {
    "name": "0763_0360009",
    "ko": "괜찮아, 장군님은 그렇게\n약하지 않을 거야."
   },
   {
    "name": "0763_0370005",
    "ko": "좋아, 조금만 더다\n폭스."
   },
   {
    "name": "0763_0380005",
