   {
    "name": "0601_0010004",
    "ko": "슬리피\n폭스… 봐… 끔찍해…"
   },
   {
    "name": "0601_0020001",
    "ko": "폭스\n사우리아 공룡들이\n무슨 짓을 했다는 거야! 용서 못 해!"
   },
   {
    "name": "0601_0030005",
    "ko": "페피\n아파로이드의 팩토리\n즉 증식원이다만"
   },
   {
    "name": "0601_0050005",
    "ko": "페피\n그것만 파괴하면\n어떻게든 될 거다."
   },
   {
    "name": "0601_0060001",
    "ko": "폭스\n좋아! 서두르자!!\n나와 크리스탈이 지상으로 간다."
   },
   {
    "name": "0601_0070001",
    "ko": "폭스\n팔코와 슬리피는 하늘을 부탁해!"
   },
   {
    "name": "0601_0080003",
    "ko": "크리스탈\n드디어 함께하는 임무네."
   },
   {
    "name": "0601_0090001",
    "ko": "폭스\n어… 아, 그렇지…"
   },
   {
    "name": "0601_0100002",
    "ko": "팔코\n너희 뭐 하냐? 간다!"
   },
   {
    "name": "title6",
    "ko": "행성 사우리아"
   }
  ]
