   {
    "name": "0000_2420005",
    "ko": "넓은 곳이면 착륙할 수 있다\n{6018:5} 길게 누르기"
   },
   {
    "name": "0000_3100001",
    "ko": "전원 무사 확인!\n레이더를 봐 줘, 페피."
   },
   {
    "name": "0000_3110005",
    "ko": "일대의 아파로이드 반응은 거의 없다…\n철수를 시작한 모양이군."
   },
   {
    "name": "0000_3330001",
    "ko": "전원 무사 확인\n이제 트리키를 찾겠다."
   },
   {
    "name": "0000_3340005",
    "ko": "음… 아파로이드는 대부분\n철수한 모양이군."
   },
   {
    "name": "0000_3560001",
    "ko": "전원 무사 확인\n팔코와 슬리피는 먼저 돌아가 줘."
   },
   {
    "name": "0000_3570003",
    "ko": "우리는 트리키를 찾을게."
