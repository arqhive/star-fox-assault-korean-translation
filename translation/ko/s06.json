   {
    "name": "0000_5020003",
    "ko": "걱정 안 해도 제대로\n하고 있어, 폭스."
   },
   {
    "name": "0000_5030002",
    "ko": "지상은 맡긴다\n폭스!"
   },
   {
    "name": "0000_5030003",
    "ko": "조심해\n폭스!"
   },
   {
    "name": "0000_5040002",
    "ko": "미안하다!\n은혜는 잊지 않을게!"
   },
   {
    "name": "0000_5040003",
    "ko": "폭스!\n도우러 와 줬구나!"
