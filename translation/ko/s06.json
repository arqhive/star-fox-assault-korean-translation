   {
    "name": "0661_0700003",
    "ko": "상공 제압은 두 사람에게\n맡길게!"
   },
   {
    "name": "0661_0710020",
    "ko": "팩토리 파괴를\n확인했습니다."
   },
   {
    "name": "0661_0720005",
    "ko": "좋다, 폭스! 남은\n팩토리는 얼마 없다!"
   },
   {
    "name": "0661_0730005",
    "ko": "그 기세다, 폭스!\n힘내 줘!"
   },
   {
    "name": "0661_0740005",
    "ko": "잘했다, 폭스!\n나머지도 정리해 버려라!"
   },
   {
    "name": "0661_0750003",
    "ko": "해냈네, 폭스!"
   },
   {
    "name": "0661_0760003",
    "ko": "해냈다~! 나머지도\n힘내자!"
   },
   {
    "name": "0661_0770003",
    "ko": "공룡들이 안 보여…\n트리키 일행은 무사할까."
   },
   {
    "name": "0661_0780005",
    "ko": "걱정 마라. 그 녀석이니\n어딘가로 피난했을 거다."
   },
   {
    "name": "0661_0790005",
    "ko": "이대로는 하늘이\n적에게 제압당하고 만다!"
   },
   {
    "name": "0661_0800002",
    "ko": "살았다.\n땡큐, 폭스!"
   },
   {
    "name": "0661_0810004",
    "ko": "위험했다~\n이제 끝인 줄 알았어~"
   },
   {
    "name": "0661_0820005",
    "ko": "잘했다, 폭스!\n하늘의 적은 잠잠해졌다."
   },
   {
    "name": "0661_0850003",
    "ko": "해냈다~!!\n작전 완료야!!"
   },
   {
    "name": "0661_0860005",
    "ko": "괜찮으냐!?\n대공포를 조심해라!"
   },
   {
    "name": "0661_0870002",
    "ko": "이렇게 많으면\n아무리 나라도 감당이 안 돼!"
   },
   {
    "name": "0661_0880005",
    "ko": "상황을 보고 랜드마스터와\n아윙을 골라 써라."
   },
   {
    "name": "0661_0890003",
    "ko": "좋아! 쓰러뜨렸어!"
   },
   {
    "name": "0661_0900005",
    "ko": "런처의 폭발을\n조심해라!"
   },
   {
    "name": "0661_0930001",
    "ko": "사우리아의 유적이…\n이래선 완전히 요새잖아!"
   },
   {
    "name": "0661_0940001",
    "ko": "이런!\n협공인가!"
   },
   {
    "name": "0661_0950003",
    "ko": "괜찮아!?\n폭스."
   },
   {
    "name": "0661_0970005",
    "ko": "랜드마스터 대공 능력을\n이렇게까지 다루다니."
   },
   {
    "name": "0661_0980004",
    "ko": "대단해, 폭스!"
   },
   {
    "name": "0661_0990003",
    "ko": "역시 리더야!"
   },
   {
    "name": "0661_1000002",
    "ko": "흥, 아윙이었으면\n더 잘했을걸."
   },
   {
    "name": "0661_1010003",
    "ko": "최대한 빨리 지상으로\n돌아와 줘, 폭스."
   },
   {
    "name": "0661_1020003",
    "ko": "폭스, 부탁해.\n지금은 지상을 도와줘!"
   },
   {
    "name": "0661_1030004",
    "ko": "아무리 해도\n이래선 끝이 없어~"
   },
   {
    "name": "0661_1040003",
    "ko": "트리키도\n많이 컸겠지?"
   },
   {
    "name": "0661_1050005",
    "ko": "사우리아를 구하면\n분명 만날 수 있을 거다."
   },
   {
    "name": "0661_1060005",
    "ko": "아파로이드 퇴치가 먼저다\n폭스."
   },
   {
    "name": "0661_1070002",
    "ko": "아윙에서 보는\n사우리아 노을은 최고야."
   },
   {
    "name": "0661_1080004",
    "ko": "큰 폭포가 있어.\n떨어지지 마, 폭스."
   },
   {
    "name": "0661_1090002",
    "ko": "적이 너무 많아!\n폭스, 와 줘!"
   },
   {
    "name": "0661_1100004",
    "ko": "상공은 적투성이야!\n폭스, 도와줘~!"
   },
   {
    "name": "0661_1110002",
    "ko": "얼른 팩토리를\n전멸시켜 버려."
   },
   {
    "name": "0661_1120004",
    "ko": "어서 사우리아를\n구하자, 폭스."
   },
   {
    "name": "0661_1130003",
    "ko": "폭스\n상태는 어때?"
   },
   {
    "name": "0661_1140003",
    "ko": "내 사격 솜씨도\n꽤 괜찮지?"
   },
   {
    "name": "0661_1160003",
    "ko": "사우리아의 공룡들이\n전혀 안 보이네…"
   },
   {
    "name": "0661_1170003",
    "ko": "괜찮아.\n아직 더 할 수 있어."
   },
   {
    "name": "0661_1180003",
    "ko": "이런 녀석들한테\n당하지 않아!"
   },
   {
    "name": "0661_1190003",
    "ko": "트리키 일행을 구할 때까지\n질 수 없어."
   },
   {
    "name": "0661_1200003",
    "ko": "좀 많이 당했네.\n실력이 무뎌졌나."
   },
   {
    "name": "0661_1210002",
    "ko": "꼴이 그게 뭐냐!\n정신 차려! 폭스!"
   },
   {
    "name": "0661_1220003",
    "ko": "폭스, 정신 차려!\n트리키한테 비웃음 사겠어!"
   },
   {
    "name": "0661_1230004",
    "ko": "지상 공격이\n그렇게 심해?"
   },
   {
    "name": "0661_1240003",
    "ko": "아무래도 이 장비로는\n좀 덥네."
   },
   {
    "name": "0661_1250001",
    "ko": "갈아입을 여유는\n없을 것 같은데."
   },
   {
    "name": "0661_1260003",
    "ko": "공룡들이\n거의 안 보여…"
   },
   {
    "name": "0661_1270004",
    "ko": "샤프클로 족까지\n당한 것 같아…"
   },
   {
    "name": "0661_1280004",
    "ko": "젠장~\n이 별은 무방비나 다름없어!"
   },
   {
    "name": "0661_1290004",
    "ko": "하늘의 공룡들은\n어떻게 된 거야!"
   },
   {
    "name": "0661_1300005",
    "ko": "클라우드 족은 자존심이 강하지…\n아마도……"
   },
   {
    "name": "0661_1310004",
    "ko": "…………"
   },
   {
    "name": "0661_1320002",
    "ko": "젠장! 왜 녀석들이\n사우리아 같은 곳을!"
   },
   {
    "name": "0661_1330005",
    "ko": "아파로이드는 더 큰\n에너지에 이끌린다."
   },
   {
    "name": "0661_1340005",
    "ko": "생명력이라면 사우리아 공룡이\n라일라트에서 으뜸이니까."
   },
   {
    "name": "0661_1350002",
    "ko": "칫…… 정말이지\n열받는 놈들이군!"
   },
   {
    "name": "0661_1360002",
    "ko": "폭스랑 크리스탈은\n이 별에서 만났었지."
   },
   {
    "name": "0661_1370003",
    "ko": "맞아, 그래서 이 별은\n추억의 장소야."
   },
   {
    "name": "0661_1380001",
    "ko": "벌레들 멋대로\n하게 둘까 보냐!"
   },
   {
    "name": "0661_1390005",
    "ko": "폭스\n페퍼 장군에게서 연락이다."
   },
   {
    "name": "0661_1400005",
    "ko": "코어 메모리는 무사히\n연구반에 도착한 모양이다."
   },
   {
    "name": "0661_1410004",
    "ko": "다행이다!\n이제 아빠한테 달렸네."
   },
   {
    "name": "0661_1420005",
    "ko": "하지만 방심은 금물이다."
   },
   {
    "name": "0661_1430005",
    "ko": "여전히 대량의 아파로이드가\n성계 곳곳에 나타나고 있다."
   },
   {
    "name": "0661_1440005",
    "ko": "한시라도 빨리 사우리아를 구하고\n페퍼 함대에 합류해야 한다."
   },
   {
    "name": "0661_1450005",
    "ko": "흠… 생각보다\n빠져나갈 길이 많군…"
   },
   {
    "name": "0661_1460005",
    "ko": "이 정도면 꽤 많은\n공룡이 피난했을지도…"
   },
   {
    "name": "0661_1500003",
    "ko": "끔찍해…"
   },
   {
    "name": "0661_1510001",
    "ko": "아파로이드 놈들!"
   },
   {
    "name": "0800_0020004",
    "ko": "적기 격추!"
   },
   {
    "name": "0800_0030002",
    "ko": "적기 격추!"
   }
  ]
 }
]