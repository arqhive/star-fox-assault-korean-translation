   {
    "name": "0000_5040004",
    "ko": "폭스!\n도우러 와 줬구나!"
   },
   {
    "name": "0000_5050002",
    "ko": "미안하다, 폭스\n지원을 요청한다!"
   },
   {
    "name": "0000_5050003",
    "ko": "폭스, 힘을 빌려줘!"
   },
   {
    "name": "0000_5050004",
    "ko": "여기는 슬리피!\n이제 틀렸어~"
   },
   {
    "name": "0000_5060002",
    "ko": "폭스! 지금은\n네 힘이 필요하다고!"
   },
   {
    "name": "0000_5060003",
    "ko": "기다려, 폭스!\n지금은 여기를 어떻게든 해야 해!"
   },
   {
    "name": "0000_5060004",
    "ko": "폭스, 가지 마~\n힘을 빌려줘~"
