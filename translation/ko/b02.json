[
 {
  "path": [],
  "first": "0201_0010006",
  "entries": [
   {
    "name": "0201_0010006",
    "ko": "페퍼 장군\n스타폭스 제군."
   },
   {
    "name": "0201_0020006",
    "ko": "페퍼 장군\n우리 라일라트계에\n최대의 위기가 닥치고 말았네…"
   },
   {
    "name": "0201_0030001",
    "ko": "폭스\n최대의 위기!?"
   },
   {
    "name": "0201_0040006",
    "ko": "페퍼 장군\n그렇네… 자세한 건\n연구 책임자에게 설명을 듣도록 하지."
   },
   {
    "name": "0201_0050007",
    "ko": "벨티노\n오랜만이구나, 다들"
   },
   {
    "name": "0201_0060004",
    "ko": "슬리피\n책임자가 아빠!?\n못 들었어~"
   },
   {
    "name": "0201_0070007",
    "ko": "벨티노\n아… 말 안 했던가?"
   },
   {
    "name": "0201_0080007",
    "ko": "벨티노\n으흠…\n아파로이드에 대해서인데…"
   },
   {
    "name": "0201_0090001",
    "ko": "폭스\n아파로이드…?"
   },
   {
    "name": "0201_0100007",
    "ko": "벨티노\n그래…\n너희가 싸운 녀석들 말이다."
   },
   {
    "name": "0201_0110007",
    "ko": "벨티노\n17년 전…\n단 1체의 아파로이드에게."
   },
   {
    "name": "0201_0120007",
    "ko": "벨티노\n함대 1개 사단이 괴멸당했지…"
   },
   {
    "name": "0201_0130007",
    "ko": "벨티노\n가져와 준 〈코어 메모리〉는\n우리 연구반이 해석하고 있다."
   },
   {
    "name": "0201_0140007",
    "ko": "벨티노\n다만 온전한 것이 있으면 더\n자세한 걸 알 수 있을 텐데…"
   },
   {
    "name": "0201_0150006",
    "ko": "페퍼 장군\n급한 일이네만, 카타리나 기지에서\n구조 신호가 발신되고 있네."
   },
   {
    "name": "0201_0160006",
    "ko": "페퍼 장군\n하지만 현재는 통신 불능이네."
   },
   {
    "name": "0201_0170006",
    "ko": "페퍼 장군\n아파로이드 일도 있으니…\n확인하고 와 주게."
   },
   {
    "name": "0201_0180001",
    "ko": "폭스\n알겠습니다! 장군!"
   },
   {
    "name": "0201_0190001",
    "ko": "폭스\n우선 내가 지상에 내려가서\n구조 신호의 진상을 확인하고 올게!"
   },
   {
    "name": "0201_0200003",
    "ko": "크리스탈\n혼자서?\n위험해! 나도…"
   },
   {
    "name": "0201_0210001",
    "ko": "폭스\n넌 팔코네랑\n아윙으로 하늘을 감시해 줘."
   },
   {
    "name": "0201_0220001",
    "ko": "폭스\n스타폭스 출격!"
   },
   {
    "name": "0201_0230007",
    "ko": "벨티노\n그때는 어떻게든 버텨 냈지만\n이런이런, 결국 이날이 오다니…"
   },
   {
    "name": "title2",
    "ko": "행성 카타리나"
   }
  ]
 },
