  "first": "0101_0010006",
  "entries": [
   {
    "name": "0101_0010006",
    "ko": "페퍼 장군\n늦지 않은 것 같군\n스타폭스 제군."
   },
   {
    "name": "0101_0020001",
    "ko": "폭스\n네, 페퍼 장군."
   },
   {
    "name": "0101_0030004",
    "ko": "슬리피\n깜짝 놀랐어~"
   },
   {
    "name": "0101_0040004",
    "ko": "슬리피\n안드로스 잔당이\n이렇게나 많았구나~"
   },
   {
    "name": "0101_0050005",
    "ko": "페피\n대부분은 돈으로 고용된\n무법자들이다."
   },
   {
    "name": "0101_0060003",
    "ko": "크리스탈\n오합지졸치고는\n꽤 열심히 하네."
   },
   {
    "name": "0101_0070006",
    "ko": "페퍼 장군\n반란의 주모자는\n바로 그 오이코니다."
   },
   {
    "name": "0101_0080001",
    "ko": "폭스\n그렇군요. 그래서 우리를…"
   },
   {
    "name": "0101_0090002",
    "ko": "팔코\n그 녀석과의 악연에도\n결판을 내야겠지."
   },
   {
    "name": "0101_0100006",
    "ko": "페퍼 장군\n오이코니를\n궁지로 몰아넣게!"
   },
   {
    "name": "0101_0110006",
    "ko": "페퍼 장군\n부탁하네\n스타폭스!"
   },
   {
    "name": "0101_0120001",
    "ko": "폭스\n맡겨 주십시오!"
   },
   {
    "name": "title1",
    "ko": "행성 포르투나"
   }
  ]
 },
