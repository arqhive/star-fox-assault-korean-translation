 {
  "path": [],
  "first": "0901_0010005",
  "entries": [
   {
    "name": "0901_0010005",
    "ko": "페피\n저길 봐라!\n저게 녀석들의 발진구인 모양이다…"
   },
   {
    "name": "0901_0020005",
    "ko": "페피\n아마 저걸 이용하면\n본성 내부로 갈 수 있을 거다…"
   },
   {
    "name": "0901_0030004",
    "ko": "슬리피\n그런데 발진 후에는 강력한 실드가\n쳐지는 것 같아!"
   },
   {
    "name": "0901_0040020",
    "ko": "나우스\n실드 제어 장치를 다수 확인\n표시합니다."
   },
   {
    "name": "0901_0050001",
    "ko": "폭스\n예외 없이."
   },
   {
    "name": "0901_0060001",
    "ko": "폭스\n실드 제어 장치이자\n팩토리이기도 하다는 건가…"
   },
   {
    "name": "0901_0070005",
    "ko": "페피\n진입할 수 있다면 저기뿐이다…"
   },
   {
    "name": "0901_0080005",
    "ko": "페피\n위험하지만 어떻게든 모든\n제어 장치를 파괴해서"
   },
   {
    "name": "0901_0090005",
    "ko": "페피\n실드를 해제해 줘!"
   },
   {
    "name": "title9",
    "ko": "아파로이드 본성"
   }
  ]
 },
