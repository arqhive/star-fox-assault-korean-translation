  "entries": [
   {
    "name": "0241_0010005",
    "ko": "폭스! 〈코어 메모리〉를 부탁한다!!"
   },
   {
    "name": "0241_0020001",
    "ko": "OK! 저거로군…"
   },
   {
    "name": "0241_0030005",
    "ko": "조심해라!\n상대는 정체를 알 수 없는 존재니까."
   },
   {
    "name": "0241_0040001",
    "ko": "알고 있어.\n그보다 그 SOS 반응이 사라진 것 같은데…"
   },
   {
    "name": "0241_0050005",
    "ko": "글쎄? 그거 묘하군…"
   },
   {
    "name": "0241_0060011",
    "ko": "아이고, 덕분에 살았데이~!"
   },
   {
    "name": "0241_0070001",
    "ko": "피그마!"
   },
   {
    "name": "0241_0080011",
    "ko": "부히힛, 오랜만이데이, 폭스."
   },
   {
    "name": "0241_0090001",
    "ko": "설마! 네가 SOS를…"
   },
   {
    "name": "0241_0100011",
    "ko": "부히힛"
   },
   {
    "name": "0241_0110011",
    "ko": "온 김에 이것도 챙겨 갈까!"
   },
   {
    "name": "0241_0120001",
    "ko": "그건…!"
   },
   {
    "name": "0241_0130011",
    "ko": "호오… 그리 중요한 물건이가? 부히힛\n그라믄 돈 좀 벌겠구마!"
   },
   {
    "name": "0241_0150011",
    "ko": "그라믄 잘 있그래이!"
   },
   {
    "name": "0241_0160001",
    "ko": "기다려!! 피그마!"
   },
   {
    "name": "0241_0170001",
    "ko": "젠자아앙~~!"
   },
   {
    "name": "0241_0180005",
    "ko": "폭스!! 피그마는 레이더로 추적 중이다!\n어서 그레이트폭스로 돌아와라!"
   }
  ]
 },
