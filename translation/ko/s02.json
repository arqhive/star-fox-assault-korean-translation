   {
    "name": "0000_3250001",
    "ko": "전 기체 귀환\n뭐, 나쁘지 않은 결과군."
   },
   {
    "name": "0000_3260002",
    "ko": "아파로이드라…\n상대로 부족함은 없군!"
   },
   {
    "name": "0000_3480001",
    "ko": "전 기체 귀환\n다들 다친 데는 없지?"
   },
   {
    "name": "0000_3490003",
    "ko": "너야말로 무리하지 마, 폭스."
   },
   {
    "name": "0000_3710001",
    "ko": "휴… 은혜를 원수로 갚았다는 건가."
   },
   {
    "name": "0000_3720002",
    "ko": "정말이지, 피그마 녀석!\n다음엔 봐주지 않겠어!"
   },
   {
    "name": "0000_3940001",
    "ko": "아파로이드라…\n조금 얕봤군…"
   },
   {
    "name": "0000_3950004",
    "ko": "하하…\n다음엔 힘낼게, 폭스."
   },
   {
    "name": "0260_0000002",
    "ko": "어이어이\n대장, 덤벼 보라고!"
   },
   {
    "name": "0260_0001003",
    "ko": "저 녀석 아래쪽을 노려\n폭스!"
   },
   {
    "name": "0260_0500005",
    "ko": "지금이다! 폭스!\n저 녀석의 약점은 위쪽이다!"
   },
   {
    "name": "0260_0510005",
    "ko": "호버로 위에 올라타라!\n{6018:6}"
   },
   {
    "name": "0260_0520002",
    "ko": "떨어지지 마라\n폭스!"
   },
   {
    "name": "0260_0530003",
    "ko": "위에 올라타야 쓰러뜨린다니\n정말 성가신 적이네."
   },
   {
    "name": "0260_0540005",
    "ko": "좋아! 폭스!\n거기가 녀석의 약점이다!"
   },
   {
    "name": "0260_0550005",
    "ko": "좋아! 폭스!\n그 기세다!"
   },
   {
    "name": "0260_0560005",
    "ko": "아래쪽의 빛나는 부분을\n노려라!!"
   },
   {
    "name": "0260_0570005",
    "ko": "랜드마스터로 싸워라!\n폭스!!"
   },
   {
    "name": "0260_0580002",
    "ko": "대장도 약해지고 있어!\n폭스! 조금만 더!"
   },
   {
    "name": "0260_0590005",
    "ko": "랜드마스터 공격이\n아니면 안 통하는 모양이군…"
   },
   {
    "name": "0260_0600002",
    "ko": "어이쿠\n위험해, 위험해!"
   },
   {
    "name": "0260_0610002",
    "ko": "공격은 최대한\n내가 끌어들일게! 부탁한다!"
   },
   {
    "name": "0260_0620003",
    "ko": "대공 공격이 거세서\n좀처럼 접근할 수가 없어…"
   },
   {
    "name": "0260_0630004",
    "ko": "젠장~ 이 녀석~!!"
   },
   {
    "name": "0260_0640005",
    "ko": "왜 그러냐!? 폭스\n랜드마스터에 타라."
   },
   {
    "name": "0261_0010005",
    "ko": "폭스, 우선 방해되는\n아파로이드를 쓰러뜨려라!"
   },
   {
    "name": "0261_0030005",
    "ko": "폭스! 어서\n적을 쓰러뜨려라!{6030:2}"
   },
   {
    "name": "0261_0040005",
    "ko": "지금 무기로는 비효율적이다!\n머신건을 챙겨라!"
   },
   {
    "name": "0261_0060002",
    "ko": "머신건으로 닥치는 대로\n쓰러뜨려 버려!"
   },
   {
    "name": "0261_0070005",
    "ko": "무기를 골라 쓰는 것도\n중요하다 {6018:11}"
   },
   {
    "name": "0261_0071005",
    "ko": "무기를 골라 쓰는 것도\n중요하다 {6018:9}"
   },
   {
    "name": "0261_0110001",
    "ko": "이 녀석들, 끝도 없이\n솟아 나오잖아!"
   },
   {
    "name": "0261_0120005",
    "ko": "포기하지 마라! 너라면\n할 수 있다, 폭스."
   },
   {
    "name": "0261_0130001",
    "ko": "이 녀석들!\n적당히 좀 해라!"
   },
   {
    "name": "0261_0500005",
    "ko": "구조 신호는 기지 안이다!\n폭스!"
   },
   {
    "name": "0261_0510005",
    "ko": "기지에는 입구가\n몇 군데 있을 거다, 폭스!"
   },
   {
    "name": "0261_0520002",
    "ko": "이봐이봐\n벌써 전의를 잃었냐?"
   },
   {
    "name": "0261_0530003",
    "ko": "지금 그런 데서 산책할\n때가 아니잖아!"
   },
   {
    "name": "0261_0540004",
    "ko": "빨리 기지 안으로\n돌아와~"
   },
