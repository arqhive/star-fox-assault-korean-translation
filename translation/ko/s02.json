   {
    "name": "0000_2090004",
    "ko": "폭스!\n뒤에서 적이 와!"
   },
   {
    "name": "0000_2100002",
    "ko": "폭스!\n뒤에서 노리고 있다고."
   },
   {
    "name": "0000_2110003",
    "ko": "뒤에 적이 붙었어.\n조심해, 폭스."
