 {
  "path": [
   "c35",
   "0",
   "1"
  ],
  "first": "0000_0200002",
  "entries": [
   {
    "name": "0000_0200002",
    "ko": "큭! 적과 아군도\n구별 못 하냐!"
   },
   {
    "name": "0000_0200003",
    "ko": "잠깐!\n장난은 그만해!"
   },
   {
    "name": "0000_0200004",
    "ko": "나야, 폭스~!"
   },
   {
    "name": "0000_0220001",
    "ko": "으아아~!"
   },
   {
    "name": "0000_0220002",
    "ko": "폭스~!!"
   },
   {
    "name": "0000_0220003",
    "ko": "폭스~!!"
   },
   {
    "name": "0000_0220004",
    "ko": "폭스~!!"
   },
   {
    "name": "0000_0240002",
    "ko": "내 사냥감에 손대지 마\n폭스!!"
   },
   {
    "name": "0000_0240003",
    "ko": "잠깐! 내 사냥감이야!"
   },
   {
    "name": "0000_0240004",
    "ko": "앗! 내가\n노리고 있었는데!"
   },
   {
    "name": "0000_0250002",
    "ko": "방해다, 비켜!"
   },
   {
    "name": "0000_0250003",
    "ko": "정신 차려\n폭스!"
   },
   {
    "name": "0000_0250004",
    "ko": "으악\n너무해, 폭스!"
   },
   {
    "name": "0000_0260002",
    "ko": "괜찮냐\n폭스!"
   },
   {
    "name": "0000_0260003",
    "ko": "괜찮아!? 폭스!"
   },
   {
    "name": "0000_0260004",
    "ko": "괜찮아!?\n폭스!"
   },
   {
    "name": "0000_0270002",
    "ko": "컨디션이 안 좋아 보이는데\n폭스."
   },
   {
    "name": "0000_0270003",
    "ko": "폭스\n힘내!!"
   },
   {
    "name": "0000_0270004",
    "ko": "폭스가 저러는 건\n못 보겠어~"
   },
   {
    "name": "0000_0290004",
    "ko": "적 실드 분석 완료\n모니터에 표시할게."
   },
   {
    "name": "0000_0330902",
    "ko": "아까의 답례다\n받아 둬!"
   },
   {
    "name": "0000_0330903",
    "ko": "도와준 답례야."
   },
   {
    "name": "0000_0340002",
    "ko": "폭스!\n뭐 하는 거야!"
   },
   {
    "name": "0000_0340003",
    "ko": "폭스\n농땡이 치고 있네…"
   },
   {
    "name": "0000_0340004",
    "ko": "너무해, 폭스!\n우리한테만 시킬 셈이야?"
   },
   {
    "name": "0000_0340005",
    "ko": "왜 그러냐 폭스!\n작전을 수행해라!"
   },
   {
    "name": "0000_1000005",
    "ko": "폭스~!!"
   },
   {
    "name": "0000_1160903",
    "ko": "큭! 맞았어!"
   },
   {
    "name": "0000_1170903",
    "ko": "위험해\n이대로는…!"
   },
   {
    "name": "0000_1310002",
    "ko": "괜찮냐, 폭스!\n당하면 안 된다!"
   },
   {
    "name": "0000_1320002",
    "ko": "꽤 당했구나.\n폭스, 괜찮냐?"
   },
   {
    "name": "0000_1330004",
    "ko": "그 체력으로 괜찮겠어?\n폭스~…"
   },
   {
    "name": "0000_1340004",
    "ko": "폭스가\n당하겠어~"
   },
   {
    "name": "0000_1350003",
    "ko": "폭스, 정신 차려!\n포기하지 마!"
   },
   {
    "name": "0000_1360003",
    "ko": "지지 마, 폭스!\n같이 살아남는 거야!"
   },
   {
    "name": "0000_1370005",
    "ko": "포기하지 마라, 폭스!\n너는 지지 않는다!"
   },
   {
    "name": "0000_1380005",
    "ko": "체력을 생각해서 움직여라!\n질 수는 없다!"
   },
   {
    "name": "0000_1430004",
    "ko": "컨디션 최고구나, 폭스!"
   },
   {
    "name": "0000_1570003",
    "ko": "훌륭해!\n역시 폭스야!"
   },
   {
    "name": "0000_1930002",
    "ko": "굉장한데!\n한 번에 해치웠어!"
   },
   {
    "name": "0000_1940002",
    "ko": "제법이잖아~!"
   },
   {
    "name": "0000_1950004",
    "ko": "좋았어~!\n한꺼번에 격추다!"
   },
   {
    "name": "0000_1960004",
    "ko": "잘하는데~ 폭스!"
   },
   {
    "name": "0000_1970003",
    "ko": "굉장해!\n한 번에 해치웠어!"
   },
   {
    "name": "0000_1980003",
    "ko": "나이스! 폭스!"
   },
   {
    "name": "0000_1990005",
    "ko": "잘했다!\n한 번에 처리했군!"
   },
   {
    "name": "0000_2000005",
    "ko": "폭스!\n실력이 늘었구나!"
   },
   {
    "name": "0000_2010002",
    "ko": "제법인데~ 닥치는 대로\n처리하고 있잖아!"
   },
   {
    "name": "0000_2020004",
    "ko": "우와~ 깔끔하게\n처리하고 있네!"
   },
   {
    "name": "0000_2030003",
    "ko": "그 기세야, 하나도 남김없이\n해치워 버려!"
   },
   {
    "name": "0000_2040005",
    "ko": "좋다, 폭스!\n싹 쓸어버려라!"
   },
   {
    "name": "0000_2080005",
    "ko": "적이 뒤에 있다!"
   },
   {
    "name": "0000_2090004",
    "ko": "폭스!\n뒤에서 적이 와!"
   },
   {
    "name": "0000_2100002",
    "ko": "폭스!\n뒤에서 노리고 있다고."
   },
   {
    "name": "0000_2110003",
    "ko": "뒤에 적이 붙었어.\n조심해, 폭스."
   },
   {
    "name": "0000_2150005",
    "ko": "폭스, 왼쪽이다!"
   },
   {
    "name": "0000_3080001",
    "ko": "전 기체 귀환!\n코어 메모리도 회수했다!"
   },
   {
    "name": "0000_3090005",
    "ko": "수고했다, 다들!\n바로 페퍼 장군에게 연락하자."
   },
   {
    "name": "0000_3310001",
    "ko": "전 기체 귀환. 일단 한시름 놓았군."
   },
   {
    "name": "0000_3320005",
    "ko": "음… 코어 메모리는\n페퍼 장군에게 보내도록 하지."
   },
   {
    "name": "0000_3540001",
    "ko": "전 기체 귀환\n…… 다들 무사해서 다행이야."
   },
   {
    "name": "0000_3550003",
    "ko": "피그마처럼은\n되고 싶지 않아…"
   },
   {
    "name": "0000_3770001",
    "ko": "피그마도 실컷 날뛰었군…"
   },
   {
    "name": "0000_3780002",
    "ko": "돼지 녀석…\n너무 불쌍해서 눈물도 안 나…"
   },
   {
    "name": "0000_4000001",
    "ko": "아파로이드 놈들……\n닥치는 대로군…"
   },
   {
    "name": "0000_4010004",
    "ko": "전 기체 점검이 필요하겠네… 흑흑…"
   },
   {
    "name": "0560_0010036",
    "ko": "우리와 융합하라."
   },
   {
    "name": "0560_0040003",
    "ko": "붙잡으려는 암의\n중심을 노려!"
   },
   {
    "name": "0560_0050005",
    "ko": "암의 움직임에 주의해라!"
   },
   {
    "name": "0560_0070036",
    "ko": "부히히힛… 우리와\n융합하라…"
   },
   {
    "name": "0560_0080003",
    "ko": "침식되면\n이렇게나 위협적이라니…!"
   },
   {
    "name": "0560_0090002",
    "ko": "괴물 놈! 이제 말도\n안 통하는 거냐…!?"
   },
   {
    "name": "0560_0130003",
    "ko": "운석이야! 피해!"
   },
   {
    "name": "0560_0150005",
    "ko": "무기를 처리해라!\n폭스!"
   },
   {
    "name": "0560_0160003",
    "ko": "무기를 파괴해!\n폭스!"
   },
   {
    "name": "0560_0170903",
    "ko": "꺄아아악\n폭스~"
   },
   {
    "name": "0560_0180001",
    "ko": "크, 크리스탈!"
   },
   {
    "name": "0560_0200903",
    "ko": "빠져나갈 수가 없어…!\n폭스, 도와줘!!"
   },
   {
    "name": "0560_0210903",
    "ko": "휴, 살았다.\n고마워, 폭스."
   },
   {
    "name": "0560_0240002",
    "ko": "폭스! 얼른\n정리해 버려!"
   },
   {
    "name": "0560_0250005",
    "ko": "암의 움직임을\n잘 봐라!"
   },
   {
    "name": "0560_0260036",
    "ko": "부힛…\n저항은 무의미하다…"
   },
   {
    "name": "0560_0270036",
    "ko": "부히히힛!\n그하하하핫!"
   },
   {
    "name": "0560_0320003",
    "ko": "아직이야, 폭스!\n강한 힘이 느껴져."
   },
   {
    "name": "0560_1030003",
    "ko": "레이저를 쏜 다음이\n기회야!"
   },
   {
    "name": "0560_1050020",
    "ko": "적 중앙에 고에너지\n반응을 확인했습니다."
   },
   {
    "name": "0560_1060005",
    "ko": "엄청난 에너지양이다!\n피해라! 폭스!"
   },
   {
    "name": "0560_1070005",
    "ko": "피해라, 폭스!"
   },
   {
    "name": "0560_1080036",
    "ko": "부힛…그히히힛…"
   },
   {
    "name": "0560_1090036",
    "ko": "부히히힛… 우리와\n융합하라…"
   },
   {
    "name": "0560_1120005",
    "ko": "기체를 기울여 재빨리\n피해라! ←{6018:4}→+{6030:0}"
   },
   {
    "name": "0560_1130005",
    "ko": "잘 회피하면서\n중앙이 열리길 기다려라."
   },
   {
    "name": "0560_1140004",
    "ko": "조금만 더야\n폭스."
   },
   {
    "name": "0560_1150003",
    "ko": "그 기세야! 폭스!\n대미지를 주고 있어!"
   },
   {
    "name": "0560_1160005",
    "ko": "좋다, 거기다!\n먹히고 있어!"
   },
   {
    "name": "0560_1170003",
    "ko": "힘내, 폭스!"
   },
   {
    "name": "0560_1180005",
    "ko": "포기하지 마라\n폭스!"
   },
   {
    "name": "0560_1310003",
    "ko": "위험해, 폭스!"
   },
   {
    "name": "0560_1330003",
    "ko": "의외로 재빨라."
   },
   {
    "name": "0560_1350005",
    "ko": "좋다, 폭스!\n그 기세다!"
   },
   {
    "name": "0560_1360005",
    "ko": "폭스!\n피그마의 얼굴에 쏴라!"
   },
   {
    "name": "0560_1380005",
    "ko": "지금이다, 폭스!!"
   },
   {
    "name": "0560_1390005",
    "ko": "미사일을 피해라!!"
   },
   {
    "name": "0560_1400005",
    "ko": "잘 회피하면서\n기회를 기다려라!"
   },
   {
    "name": "0560_1410005",
    "ko": "운석이 날아온다!\n조심해라!"
   },
   {
    "name": "0560_1420002",
    "ko": "정말 재주 좋은 놈이군!"
   },
   {
    "name": "0560_1440002",
    "ko": "부딪치지 마라!\n폭스!"
   },
   {
    "name": "0560_1450002",
    "ko": "드디어 나오셨군!\n피그마!"
   },
   {
    "name": "0560_1470004",
    "ko": "으악, 피해야 해!"
   },
   {
    "name": "0560_1480004",
    "ko": "으아아, 잔뜩\n날아오네…"
   },
   {
    "name": "0560_1500004",
    "ko": "히익~ 위험한데!"
   },
   {
    "name": "0560_1510004",
    "ko": "좋았어!\n암이 전부 부서졌어!"
   },
   {
    "name": "0561_0010001",
    "ko": "전 기체, 소행성대로\n돌입한다!"
   },
   {
    "name": "0561_0020002",
    "ko": "운석 수가 많군…"
   },
   {
    "name": "0561_0030004",
    "ko": "별거 아니야.\n괜찮아, 괜찮아!"
   },
   {
    "name": "0561_0040002",
    "ko": "태평한 녀석이라니까\n정말."
   },
   {
    "name": "0561_0050003",
    "ko": "그게 슬리피의\n장점이잖아."
   },
   {
    "name": "0561_0060004",
    "ko": "흥!"
   },
   {
    "name": "0561_0070003",
    "ko": "조심해!\n뭔가 있어!"
   },
   {
    "name": "0561_0080004",
    "ko": "우와! 이런 곳에도\n아파로이드가!"
   },
   {
    "name": "0561_0090002",
    "ko": "피그마 녀석\n무슨 꿍꿍이야…"
   },
   {
    "name": "0561_0100902",
    "ko": "젠장~\n끈질긴 녀석들이군!"
   },
   {
    "name": "0561_0110902",
    "ko": "살았다, 폭스."
   },
   {
    "name": "0561_0120003",
    "ko": "방심은 금물이야\n팔코."
   },
   {
    "name": "0561_0130004",
    "ko": "앗! 이 운석 이상해.\n이쪽으로 다가와."
   },
   {
    "name": "0561_0140002",
    "ko": "분사 노즐이\n달려 있잖아!"
   },
   {
    "name": "0561_0210902",
    "ko": "폭스\n뒤에 붙은 녀석 좀 부탁해."
   },
   {
    "name": "0561_0220902",
    "ko": "떼어낼 수가 없어~"
   },
   {
    "name": "0561_0240902",
    "ko": "한 방 먹었군…"
   },
   {
    "name": "0561_0250004",
    "ko": "뭐야 이 녀석, 아윙에\n달라붙잖아."
   },
   {
    "name": "0561_0260005",
    "ko": "롤링을 해 봐라!\n{6030:0} 꾹 누르기"
   },
   {
    "name": "0561_0270004",
    "ko": "격추 수가 대단해!\n폭스!"
   },
   {
    "name": "0561_0280002",
    "ko": "이대로라면\n편하게 나아가겠군."
   },
   {
    "name": "0561_0290003",
    "ko": "그렇지도 않은가 봐.\n적 반응이 커지고 있어."
   },
   {
    "name": "0561_0300001",
    "ko": "바라던 바다!"
   },
   {
    "name": "0561_0310001",
    "ko": "적의 공격도\n거세졌군…"
   },
   {
    "name": "0561_0500004",
    "ko": "어라, 방금 그거…?"
   },
   {
    "name": "0561_0510002",
    "ko": "설마…\n울펜이냐!?"
   },
   {
    "name": "0561_0520004",
    "ko": "당한 거야?\n울프 일당이!?"
   },
   {
    "name": "0561_0540002",
    "ko": "또다!"
   },
   {
    "name": "0561_0550004",
    "ko": "왠지 으스스해~…"
   },
   {
    "name": "0561_0560001",
    "ko": "아파로이드… 아니\n피그마의 짓인가……?"
   },
   {
    "name": "0561_0570001",
    "ko": "다들, 방심하지 마!"
   },
   {
    "name": "0561_0580003",
    "ko": "약한 잔류 사념이 느껴져.\n탈출은 한 것 같아…"
   },
   {
    "name": "0562_0090004",
    "ko": "으악, 막혀 버린다~"
   },
   {
    "name": "0562_0100005",
    "ko": "부스트로 빠져나가라!\n{6018:6}"
   },
   {
    "name": "0562_0240001",
    "ko": "좋아, 무사히 빠져나왔군."
   },
   {
    "name": "0562_0260001",
    "ko": "휴, 위험했어…"
   },
   {
    "name": "0563_0020004",
    "ko": "건설 중인 기지\n같네…"
   },
   {
    "name": "0563_0040002",
    "ko": "기지까지 만들고 있었나…"
   },
   {
    "name": "0563_0050005",
    "ko": "피그마 녀석, 여전히\n빈틈이 없는 놈이군…"
   },
   {
    "name": "0563_0090902",
    "ko": "크악, 뒤를 잡혔어.\n떼어낼 수가 없어!"
   },
   {
    "name": "0563_0100902",
    "ko": "미안하다… 꼴사나운 모습\n보여 버렸군."
   },
   {
    "name": "0563_0110902",
    "ko": "위험해…"
   },
   {
    "name": "0563_0120902",
    "ko": "칫, 미안하지만 이탈한다."
   },
   {
    "name": "0563_0140003",
    "ko": "슬리피, 뒤!"
   },
   {
    "name": "0563_0150904",
    "ko": "으아~ 어떡하지~"
   },
   {
    "name": "0563_0160904",
    "ko": "땡큐, 폭스."
   },
   {
    "name": "0563_0170904",
    "ko": "으아아아!"
   },
   {
    "name": "0563_0180904",
    "ko": "이제 틀렸어~!!\n이탈할게."
   },
   {
    "name": "0563_0200001",
    "ko": "뭐지? 여기는…"
   },
   {
    "name": "0563_0210003",
    "ko": "피그마의 반응은\n이 앞인 것 같아."
   },
   {
    "name": "0563_0270001",
    "ko": "좋아!\n저기로 들어간다!"
   },
   {
    "name": "0563_0290001",
    "ko": "응? 이 녀석은…\n그때 그 신형 아니야?"
   },
   {
    "name": "0563_0300003",
    "ko": "잘 봐! 아파로이드에\n침식당했어!"
   },
   {
    "name": "0563_0310004",
    "ko": "히이익"
   },
   {
    "name": "0563_0320904",
    "ko": "그만해~\n따라오지 마~~"
   },
   {
    "name": "0563_0330001",
    "ko": "여기도 막혔나…!?"
   },
   {
    "name": "0563_0340005",
    "ko": "부딪치지 않게\n조심해라!"
   },
   {
    "name": "0563_0350003",
    "ko": "막다른 길이야!\n폭스!"
   },
   {
    "name": "0563_0360001",
    "ko": "이쪽이다!"
   },
   {
    "name": "0563_0390003",
    "ko": "이 앞에 피그마가 있어…"
   },
   {
    "name": "0563_0400005",
    "ko": "폭스!\n충분히 주의해라!"
   },
   {
    "name": "1061_0080003",
    "ko": "전방의 적 반응 증대!"
   },
   {
    "name": "0562_0120005",
    "ko": "부딪친다!\n브레이크를 써라! {6030:2}"
   },
   {
    "name": "0561_0320004",
    "ko": "괜찮아, 폭스?\n이걸로 좀 회복해."
   }
