 {
  "path": [
   "c48",
   "0",
   "1"
  ],
  "first": "0000_0200002",
  "entries": [
   {
    "name": "0000_0200002",
    "ko": "큭! 적과 아군도\n구별 못 하냐!"
   },
   {
    "name": "0000_0200003",
    "ko": "잠깐!\n장난은 그만해!"
   },
   {
    "name": "0000_0200004",
    "ko": "나야, 폭스~!"
   },
   {
    "name": "0000_0220001",
    "ko": "으아아~!"
   },
   {
    "name": "0000_0220002",
    "ko": "폭스~!!"
   },
   {
    "name": "0000_0220003",
    "ko": "폭스~!!"
   },
   {
    "name": "0000_0220004",
    "ko": "폭스~!!"
   },
   {
    "name": "0000_0240002",
    "ko": "내 사냥감에 손대지 마\n폭스!!"
   },
   {
    "name": "0000_0240003",
    "ko": "잠깐! 내 사냥감이야!"
   },
   {
    "name": "0000_0240004",
    "ko": "앗! 내가\n노리고 있었는데!"
   },
   {
    "name": "0000_0250002",
    "ko": "방해다, 비켜!"
   },
   {
    "name": "0000_0250003",
    "ko": "정신 차려\n폭스!"
   },
   {
    "name": "0000_0250004",
    "ko": "으악\n너무해, 폭스!"
   },
   {
    "name": "0000_0260002",
    "ko": "괜찮냐\n폭스!"
   },
   {
    "name": "0000_0260003",
    "ko": "괜찮아!? 폭스!"
   },
   {
    "name": "0000_0260004",
    "ko": "괜찮아!?\n폭스!"
   },
   {
    "name": "0000_0270002",
    "ko": "컨디션이 안 좋아 보이는데\n폭스."
   },
   {
    "name": "0000_0270003",
    "ko": "폭스\n힘내!!"
   },
   {
    "name": "0000_0270004",
    "ko": "폭스가 저러는 건\n못 보겠어~"
   },
   {
    "name": "0000_0290004",
    "ko": "적 실드 분석 완료\n모니터에 표시할게."
   },
   {
    "name": "0000_0300904",
    "ko": "폭스! 뒤에 붙은 적 좀\n어떻게 해 줘~"
   },
   {
    "name": "0000_0340002",
    "ko": "폭스!\n뭐 하는 거야!"
   },
   {
    "name": "0000_0340003",
    "ko": "폭스\n농땡이 치고 있네…"
   },
   {
    "name": "0000_0340004",
    "ko": "너무해, 폭스!\n우리한테만 시킬 셈이야?"
   },
   {
    "name": "0000_0340005",
    "ko": "왜 그러냐 폭스!\n작전을 수행해라!"
   },
   {
    "name": "0000_1000005",
    "ko": "폭스~!!"
   },
   {
    "name": "0000_1310002",
    "ko": "괜찮냐, 폭스!\n당하면 안 된다!"
   },
   {
    "name": "0000_1320002",
    "ko": "꽤 당했구나.\n폭스, 괜찮냐?"
   },
   {
    "name": "0000_1330004",
    "ko": "그 체력으로 괜찮겠어?\n폭스~…"
   },
   {
    "name": "0000_1340004",
    "ko": "폭스가\n당하겠어~"
   },
   {
    "name": "0000_1350003",
    "ko": "폭스, 정신 차려!\n포기하지 마!"
   },
   {
    "name": "0000_1360003",
    "ko": "지지 마, 폭스!\n같이 살아남는 거야!"
   },
   {
    "name": "0000_1370005",
    "ko": "포기하지 마라, 폭스!\n너는 지지 않는다!"
   },
   {
    "name": "0000_1380005",
    "ko": "체력을 생각해서 움직여라!\n질 수는 없다!"
   },
   {
    "name": "0000_2080005",
    "ko": "적이 뒤에 있다!"
   },
   {
    "name": "0000_2090004",
    "ko": "폭스!\n뒤에서 적이 와!"
   },
   {
    "name": "0000_2100002",
    "ko": "폭스!\n뒤에서 노리고 있다고."
   },
   {
    "name": "0000_2110003",
    "ko": "뒤에 적이 붙었어.\n조심해, 폭스."
   },
   {
    "name": "0000_3060001",
    "ko": "전 기체 귀환!"
   },
   {
    "name": "0000_3070005",
    "ko": "기상 컨트롤 센터는 무사히 가동 중이다\n잘했다, 다들!"
   },
   {
    "name": "0000_3290001",
    "ko": "전 기체 귀환\n휴~ 이제야 살 것 같군."
   },
   {
    "name": "0000_3300005",
    "ko": "수고했다. 나우스, 따뜻한\n커피 좀 끓여 주게."
   },
   {
    "name": "0000_3520001",
    "ko": "전 기체 귀환\n다들 감기 조심해."
   },
   {
    "name": "0000_3530005",
    "ko": "수고했다\n따뜻한 샤워라도 하게."
   },
   {
    "name": "0000_3750001",
    "ko": "역시 추위가 혹독했어."
   },
   {
    "name": "0000_3760004",
    "ko": "겨울잠 자는 줄 알았어…\n덜덜덜…"
   },
   {
    "name": "0000_3980001",
    "ko": "간신히 버텨 낸 느낌이군…"
   },
   {
    "name": "0000_3990002",
    "ko": "정말이지, 아윙이 울고 있다고."
   },
   {
    "name": "0461_0011005",
    "ko": "배리어 발생 장치가\n슬슬 보일 거다."
   },
   {
    "name": "0461_0030001",
    "ko": "알았어! 그나저나\n지독한 눈보라군…"
   },
   {
    "name": "0461_0040004",
    "ko": "기상 컨트롤 센터에는\n아직 못 들어가!"
   },
   {
    "name": "0461_0050004",
    "ko": "배리어 발생 장치를\n부숴야 해!"
   },
   {
    "name": "0461_0060005",
    "ko": "폭스, 여기는\n높낮이를 조심해라!"
   },
   {
    "name": "0461_0070002",
    "ko": "절벽 위에서 떨어뜨리는\n폭탄을 조심해라!"
   },
   {
    "name": "0461_0081003",
    "ko": "폭스, 절벽에서\n발을 헛디디지 않게 조심해."
   },
   {
    "name": "0461_0090004",
    "ko": "적 무리가 몇 군데\n있어. 조심해!"
   },
   {
    "name": "0461_0110002",
    "ko": "시간이 너무 걸리는데\n괜찮은 거야?"
   },
   {
    "name": "0461_0120003",
    "ko": "폭스를 믿을 수밖에\n없어…"
   },
   {
    "name": "0461_0130004",
    "ko": "폭스~…"
   },
   {
    "name": "0461_0150002",
    "ko": "폭스, 꽤\n솜씨 좋았어!"
   },
   {
    "name": "0461_0190005",
    "ko": "배리어 발생 장치 본체는\n파괴할 수 없다."
   },
   {
    "name": "0461_0200005",
    "ko": "그 녀석의 동력원을\n파괴해라."
   },
   {
    "name": "0461_0210005",
    "ko": "그걸 부수고 기상 컨트롤\n센터에 들어가는 거다."
   },
   {
    "name": "0461_0220003",
    "ko": "그 기세야!\n폭스!"
   },
   {
    "name": "0461_0230003",
    "ko": "배리어 발생 장치는\n앞으로 2개야!"
   },
   {
    "name": "0461_0240003",
    "ko": "배리어 발생 장치는\n앞으로 1개야!"
   },
   {
    "name": "0461_0270005",
    "ko": "폭스! 어딘가 안으로\n들어갈 만한 곳은 없나?!"
   },
   {
    "name": "0461_0290005",
    "ko": "배리어 발생 장치는\n레이더에 표시돼 있다."
