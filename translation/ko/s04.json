[
 {
  "path": [
   "c30",
   "0",
   "c1",
   "0",
   "1"
  ],
  "first": "0421_0010001",
  "entries": [
   {
    "name": "0421_0010001",
    "ko": "나우스\n컨트롤 센터를 스캔해 줘."
   },
   {
    "name": "0421_0020020",
    "ko": "알겠습니다."
   },
   {
    "name": "0421_0030020",
    "ko": "기상 컨트롤 센터에\n배리어가 작동 중입니다."
   },
   {
    "name": "0421_0040005",
    "ko": "음… 그렇다면 센터 안에 들어가려면\n우선 배리어를 해제해야겠군…"
   },
   {
    "name": "0421_0050001",
    "ko": "그런 것 같군…"
   },
   {
    "name": "0421_0060001",
    "ko": "시간이 없어. 좀 거칠지만\n배리어 발생 장치를 파괴한다."
   },
   {
    "name": "0421_0070005",
    "ko": "너무 무리하지는 마라, 폭스."
   },
   {
    "name": "0421_0080001",
    "ko": "알고 있어."
   },
   {
    "name": "0421_0090002",
    "ko": "얼른 좀 해 줘!\n이쪽은 심심해 죽겠다고!"
   },
   {
    "name": "0421_0100001",
    "ko": "계속 심심하길 빌게."
   }
  ]
 },
 {
  "path": [
   "c31",
   "0",
   "c1",
   "0",
   "1"
  ],
  "first": "0431_0010001",
  "entries": [
   {
    "name": "0431_0010001",
    "ko": "이거로군…"
   },
   {
    "name": "0431_0020026",
    "ko": "컨트롤 설정 확인, 시동합니다."
   },
   {
    "name": "0431_0030004",
    "ko": "해냈다~!\n눈보라가 걷히고 있어~!"
   },
   {
    "name": "0431_0040003",
    "ko": "해냈네! 폭스!"
   },
   {
    "name": "0431_0050003",
    "ko": "…폭스?"
   },
   {
    "name": "0431_0060002",
    "ko": "왜 그래, 폭스! 응답해!"
   },
   {
    "name": "0431_0070001",
    "ko": "소리 지르지 마, 팔코! 난 무사해."
   },
   {
    "name": "0431_0080001",
    "ko": "그런데…\n좀 곤란한 일이 생겼어…"
   },
   {
    "name": "0431_0090001",
    "ko": "인증 오류일지도 모르지만\n여기 경비 로봇한테 찍혀 버렸거든…"
   },
   {
    "name": "0431_0100002",
    "ko": "분명 피그마의 함정이야!\n내가 그쪽으로 갈게! 어떻게든 버텨!"
   },
   {
    "name": "0431_0110001",
    "ko": "그래, 빨리 부탁한다…!"
   }
  ]
 },
 {
  "path": [
   "c32",
   "0",
   "c1",
   "0",
   "1"
  ],
  "first": "0432_0010002",
  "entries": [
   {
    "name": "0432_0010002",
    "ko": "받아라, 받아라, 받아라, 받아라앗!!"
   },
   {
    "name": "0432_0020001",
    "ko": "팔코!"
   },
   {
    "name": "0432_0030001",
    "ko": "이런이런, 요란한 마중이군…"
   },
   {
    "name": "0432_0040002",
    "ko": "투덜대지 말고\n내 아윙에 올라타!"
   },
   {
    "name": "0432_0050001",
    "ko": "좋아!"
   },
   {
    "name": "0432_0060002",
    "ko": "모처럼 주워 줬으니까\n떨어지지 마라!"
   },
   {
    "name": "0432_0070001",
    "ko": "너야말로\n추락하지나 말라고!"
   },
   {
    "name": "0432_0080002",
    "ko": "웃기시네!"
   },
   {
    "name": "0432_0090002",
    "ko": "폭스!\n특기인 사격으로 녀석들을 쓸어버려!"
   }
  ]
 },
 {
  "path": [
   "c33",
   "0",
   "c1",
   "0",
   "1"
  ],
  "first": "0433_0010004",
  "entries": [
   {
    "name": "0433_0010004",
    "ko": "폭스, 이상해서 조사해 봤더니\n아까 그 경비 로봇도 아파로이드였어!"
   },
   {
    "name": "0433_0020001",
    "ko": "뭐라고!?"
   },
   {
    "name": "0433_0030004",
    "ko": "아파로이드는 다른 기계도\n자기들 일부로 만들어 버리는 거야…!"
   },
   {
    "name": "0433_0040002",
    "ko": "진짜냐!"
   },
   {
    "name": "0433_0050040",
    "ko": "진짜데이~"
   },
   {
    "name": "0433_0060040",
    "ko": "그라고 그놈들을 조종하는 게\n바로 피그마 님이란 말씀이다!"
   },
   {
    "name": "0433_0070001",
    "ko": "!!"
   },
   {
    "name": "0433_0080001",
    "ko": "피그마!!"
   },
   {
    "name": "0433_0090011",
    "ko": "베이비~! 컴 온~♪"
   },
   {
    "name": "0433_0100001",
    "ko": "뭣!?"
   },
   {
    "name": "0433_0110001",
    "ko": "저건 시설의 일부잖아!?"
   },
   {
    "name": "0433_0120004",
    "ko": "아파로이드한테 침식당한 거야!"
   },
   {
    "name": "0433_0130002",
    "ko": "돼지 자식!"
   },
   {
    "name": "0433_0140011",
    "ko": "내한테 신경 쓰고 있어도 되겠나~?\n그놈들 처리 안 하면 큰일 난데이~ 부히히"
   },
   {
    "name": "0433_0150020",
    "ko": "위험! 위험! 기상 컨트롤 장치가\n오버로드 상태입니다."
   },
   {
    "name": "0433_0160005",
    "ko": "피그마는 나중이다! 폭스\n다시는 눈보라를 멈출 수 없게 된다!"
   },
   {
    "name": "0433_0170001",
    "ko": "…알았다."
   },
   {
    "name": "0433_0180011",
    "ko": "부히히히……\n히야하하하하하……"
   }
  ]
 },
 {
  "path": [
   "c34",
   "0",
   "c1",
   "0",
   "1"
  ],
  "first": "0441_0010001",
  "entries": [
   {
    "name": "0441_0010001",
    "ko": "여기는 폭스\n기상 컨트롤 장치가 무사한 걸 확인했다."
   },
   {
    "name": "0441_0020004",
    "ko": "아파로이드도 이제 없는 것 같네…"
   },
   {
    "name": "0441_0030003",
    "ko": "수고했어, 폭스."
   },
   {
    "name": "0441_0040002",
    "ko": "그나저나 아군한테까지 공격당하다니\n영 달갑지 않은 일이군."
   },
   {
    "name": "0441_0050005",
    "ko": "기계는 결국 기계… 의지가 없는 것은\n쉽게 적도 아군도 된다는 거다."
   },
   {
    "name": "0441_0060001",
    "ko": "강한 의지가 없는 것은 적도 아군도 된다는 건가…"
   },
   {
    "name": "0441_0070003",
    "ko": "왜 그래? 폭스."
   },
   {
    "name": "0441_0080001",
    "ko": "아니, 누구 얘기 같아서 말이야…"
   },
   {
    "name": "0441_0090011",
    "ko": "나를 따르라… 나를 따르라…\n나를 따르라… 나를…"
   },
   {
    "name": "0441_0100011",
    "ko": "부힛!?\n내가 방금 잠꼬대했나…"
   },
   {
    "name": "0441_0110011",
    "ko": "아… 안 된데이. 저놈들 부려서 돈 버는 건\n내다! 내가… 내… 따르라…"
   }
  ]
 },
