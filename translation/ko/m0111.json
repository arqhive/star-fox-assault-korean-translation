   {
    "name": "0111_0010012",
    "ko": "안돌프의 잔당 놈들!"
   },
   {
    "name": "0111_0020012",
    "ko": "꽤나 애먹였다만\n드디어 끝이로군."
   },
   {
    "name": "0111_0090016",
    "ko": "밀리지 마라! 똥개 놈들한테\n근성을 보여 줘라!"
   },
   {
    "name": "0111_0030012",
    "ko": "전 함대! V자 밀집 진형을 갖춰라!\n중앙 돌파 후 각개 격파!"
   },
   {
    "name": "0111_0040044",
    "ko": "코네리아 함대, 제2차 전투 구역 돌입!\n돌격해 오고 있습니다!"
   },
   {
    "name": "0111_0050016",
    "ko": "얕보다니…\n이렇게 된 이상 비장의 무기다!"
   },
   {
    "name": "0111_0060016",
    "ko": "잠항 함대! 공격 개시!"
   },
   {
    "name": "0111_0120012",
    "ko": "원숭이 놈들! 잔당이라 얕봤더니\n역시 필사적이란 건가."
   },
   {
    "name": "0111_0130021",
    "ko": "전투 구역 밖에서 게이트 아웃 반응!"
   },
   {
    "name": "0111_0140021",
    "ko": "그레이트폭스…!? 사령관님!\n폭스 팀입니다!"
   },
   {
    "name": "0111_0150001",
    "ko": "여기는 스타폭스, 지원하러 왔다!"
   },
   {
    "name": "0111_0160004",
    "ko": "저런 녀석들쯤 식은 죽 먹기지\n우리한테 맡겨 두라고~"
   }
