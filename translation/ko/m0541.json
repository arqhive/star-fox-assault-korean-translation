  "first": "0541_0050006",
  "entries": [
   {
    "name": "0541_0050006",
    "ko": "수고했네, 스타폭스 제군."
   },
   {
    "name": "0541_0060001",
    "ko": "간신히 온전한 〈코어 메모리〉를 회수했습니다.\n이제 본성의 위치를 알 수 있겠군요!"
   },
   {
    "name": "0541_0070006",
    "ko": "잘해 주었네. 아파로이드 마더로 가는 길이\n열렸군…"
   },
   {
    "name": "0541_0080001",
    "ko": "…… 마더…?"
   },
   {
    "name": "0541_0090006",
    "ko": "녀석들의 본성에는 마더라 할 만한 본체가 있어\n모든 아파로이드의 의지를 통솔하는 듯하네."
   },
   {
    "name": "0541_0100006",
    "ko": "골치 아프게도 마더가 존재하는 한\n아파로이드는 무한히 증식하지!"
   },
   {
    "name": "0541_0150001",
    "ko": "알겠습니다. 바로 전달하겠습니다."
   },
   {
    "name": "0541_0160003",
    "ko": "폭스…"
   },
   {
    "name": "0541_0170001",
    "ko": "응?"
   },
   {
    "name": "0541_0180003",
    "ko": "행성 사우리아의 SOS가 느껴져…"
   },
   {
    "name": "0541_0190001",
    "ko": "사우리아? 트리키 일행인가!?"
   },
   {
    "name": "0541_0200003",
    "ko": "모르겠어… 하지만… 비통한 외침이 느껴져…"
   }
  ]
 }
]