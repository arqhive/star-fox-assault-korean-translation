 {
  "path": [
   "c31",
   "0",
   "c1",
   "0",
   "1"
  ],
  "first": "0132_0010002",
  "entries": [
   {
    "name": "0132_0010002",
    "ko": "어이쿠"
   },
   {
    "name": "0132_0020002",
    "ko": "벌써부터 마중을 나왔군!"
   },
   {
    "name": "0132_0030001",
    "ko": "크리스탈은 처음 싸워 보는 상대지.\n조심해서 가!"
   },
   {
    "name": "0132_0040003",
    "ko": "걱정 마. 시뮬레이션 성적은\n슬리피보다 훨씬 좋으니까!"
   },
   {
    "name": "0132_0050004",
    "ko": "하하… 그 얘긴 하지 말아 줘~"
   },
   {
    "name": "0132_0060002",
    "ko": "흥, 이런 녀석들은 나 혼자로도 충분해!"
   },
   {
    "name": "0132_0070005",
    "ko": "허허, 다들 의욕이 넘치는구먼.\n이거 나도 슬슬 은퇴해야 하려나?"
   },
   {
    "name": "0132_0080005",
    "ko": "부탁한다! 스타폭스!"
   }
  ]
 },
 {
  "path": [
   "c32",
   "0",
   "c1",
   "0",
   "1"
  ],
  "first": "0133_0010016",
  "entries": [
   {
    "name": "0133_0010016",
    "ko": "흐흐흐흐흐…… 하하하하하핫!!\n그 정도 공격 따위!!"
   },
   {
    "name": "0133_0020016",
    "ko": "나는 위대한 황제 안돌프의\n정통 후계자!"
   },
   {
    "name": "0133_0030016",
    "ko": "신황제 앤드류 오이코니!"
   },
   {
    "name": "0133_0031016",
    "ko": "안돌프 삼촌~…"
   },
   {
    "name": "0133_0040001",
    "ko": "뭐지? 지원군인가?"
   },
   {
    "name": "0133_0050002",
    "ko": "친구 같아 보이진 않는데…"
   },
   {
    "name": "0133_0060003",
    "ko": "뭐지?… 이 위화감은…"
   },
   {
    "name": "0133_0070005",
    "ko": "설마… 이 녀석은…!?"
   },
   {
    "name": "0133_0080020",
    "ko": "아파로이드, 아파로이드, 아파로이드!"
   },
   {
    "name": "0133_0090001",
    "ko": "아파로이드!?"
   },
   {
    "name": "0133_0100003",
    "ko": "으아아~!"
   },
   {
    "name": "0133_0110001",
    "ko": "망설일 때가 아니군! 응전한다!"
   }
  ]
 },
 {
  "path": [
   "c33",
   "0",
   "c1",
   "0",
   "1"
  ],
  "first": "0134_0010016",
  "entries": [
   {
    "name": "0134_0010016",
    "ko": "술래잡기는 여기까지다아아아!"
   },
   {
    "name": "0134_0020016",
    "ko": "진정한 힘을 보여 주마!!"
   },
   {
    "name": "0134_0030001",
    "ko": "오이코니 녀석, 무슨 속셈이냐!?"
   },
   {
    "name": "0134_0040005",
    "ko": "조심해라, 폭스!\n궁지에 몰린 원숭이는 무슨 짓을 할지 모른다!"
   },
   {
    "name": "0134_0050016",
    "ko": "악연에 종지부를 찍어 주마!"
   },
   {
    "name": "0134_0060016",
    "ko": "죽어라!!"
   },
   {
    "name": "0134_0061016",
    "ko": "와하하하핫!"
   },
   {
    "name": "0134_0070001",
    "ko": "그걸로 이겼다고 생각하다니\n웃기는군, 오이코니!"
   }
  ]
 },
 {
  "path": [
   "c34",
   "0",
   "c1",
   "0",
   "1"
  ],
  "first": "0135_0010005",
  "entries": [
   {
    "name": "0135_0010005",
    "ko": "오이코니 녀석이니, 도망친 척하고\n매복하고 있을지도 모른다…"
   },
   {
    "name": "0135_0020005",
    "ko": "모두, 충분히 주의하도록."
   },
   {
    "name": "0135_0030002",
    "ko": "걱정이 너무 많은 거 아냐? 영감."
   },
   {
    "name": "0135_0040001",
    "ko": "지표에 도달한다!"
   }
  ]
 },
 {
  "path": [
   "c35",
   "0",
   "c1",
   "0",
   "1"
  ],
  "first": "0141_0010003",
  "entries": [
   {
    "name": "0141_0010003",
    "ko": "간신히 해치웠네."
   },
   {
    "name": "0141_0080001",
    "ko": "그래도 묘한 상대였어…"
   },
   {
    "name": "0141_0040001",
    "ko": "응? 저건…?"
   },
   {
    "name": "0141_0060005",
    "ko": "폭스, 그걸 회수해라!"
   },
   {
    "name": "0141_0070001",
    "ko": "…? 알았다."
   },
   {
    "name": "0141_0080004",
    "ko": "포… 폭스!"
   },
   {
    "name": "0141_0090002",
    "ko": "뭐… 뭐야!?"
   },
   {
    "name": "0141_0100005",
    "ko": "안 돼! 폭스!\n그걸 회수하고 바로 철수해라!"
   }
  ]
 },
