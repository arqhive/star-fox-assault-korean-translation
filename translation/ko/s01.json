 {
  "path": [
   "c49",
   "0",
   "1"
  ],
  "first": "0000_0200002",
  "entries": [
   {
    "name": "0000_0200002",
    "ko": "큭! 적과 아군도\n구별 못 하냐!"
   },
   {
    "name": "0000_0200003",
    "ko": "잠깐!\n장난은 그만해!"
   },
   {
    "name": "0000_0200004",
    "ko": "나야, 폭스~!"
   },
   {
    "name": "0000_0220001",
    "ko": "으아아~!"
   },
   {
    "name": "0000_0220002",
    "ko": "폭스~!!"
   },
   {
    "name": "0000_0220003",
    "ko": "폭스~!!"
   },
   {
    "name": "0000_0220004",
    "ko": "폭스~!!"
   },
   {
    "name": "0000_0240002",
    "ko": "내 사냥감에 손대지 마\n폭스!!"
   },
   {
    "name": "0000_0240003",
    "ko": "잠깐! 내 사냥감이야!"
   },
   {
    "name": "0000_0240004",
    "ko": "앗! 내가\n노리고 있었는데!"
   },
   {
    "name": "0000_0250002",
    "ko": "방해다, 비켜!"
   },
   {
    "name": "0000_0250003",
    "ko": "정신 차려\n폭스!"
   },
   {
    "name": "0000_0250004",
    "ko": "으악\n너무해, 폭스!"
   },
   {
    "name": "0000_0260002",
    "ko": "괜찮냐\n폭스!"
   },
   {
    "name": "0000_0260003",
    "ko": "괜찮아!? 폭스!"
   },
   {
    "name": "0000_0260004",
    "ko": "괜찮아!?\n폭스!"
   },
   {
    "name": "0000_0270002",
    "ko": "컨디션이 안 좋아 보이는데\n폭스."
   },
   {
    "name": "0000_0270003",
    "ko": "폭스\n힘내!!"
   },
   {
    "name": "0000_0270004",
    "ko": "폭스가 저러는 건\n못 보겠어~"
   },
   {
    "name": "0000_0290004",
    "ko": "적 실드 분석 완료\n모니터에 표시할게."
   },
   {
    "name": "0000_0340002",
    "ko": "폭스!\n뭐 하는 거야!"
   },
   {
    "name": "0000_0340003",
    "ko": "폭스\n농땡이 치고 있네…"
   },
   {
    "name": "0000_0340004",
    "ko": "너무해, 폭스!\n우리한테만 시킬 셈이야?"
   },
   {
    "name": "0000_1000005",
    "ko": "폭스~!!"
   },
   {
    "name": "0000_1310002",
    "ko": "괜찮냐, 폭스!\n당하면 안 된다!"
   },
   {
    "name": "0000_1320002",
    "ko": "꽤 당했구나.\n폭스, 괜찮냐?"
   },
   {
    "name": "0000_1330004",
    "ko": "그 체력으로 괜찮겠어?\n폭스~…"
   },
   {
    "name": "0000_1340004",
    "ko": "폭스가\n당하겠어~"
   },
   {
    "name": "0000_1350003",
    "ko": "폭스, 정신 차려!\n포기하지 마!"
   },
   {
    "name": "0000_1360003",
    "ko": "지지 마, 폭스!\n같이 살아남는 거야!"
   },
   {
    "name": "0000_1370005",
    "ko": "포기하지 마라, 폭스!\n너는 지지 않는다!"
   },
   {
    "name": "0000_1380005",
    "ko": "체력을 생각해서 움직여라!\n질 수는 없다!"
   },
   {
    "name": "0000_1390002",
    "ko": "제법인데! 폭스!"
   },
   {
    "name": "0000_1460003",
    "ko": "대단해\n폭스!"
   },
   {
    "name": "0000_1480005",
    "ko": "제법이구나, 폭스!"
   },
   {
    "name": "0000_1500005",
    "ko": "너를 보고 있으면\n내 젊은 시절이 생각나는구먼."
   },
   {
    "name": "0000_1930002",
    "ko": "굉장한데!\n한 번에 해치웠어!"
   },
   {
    "name": "0000_1940002",
    "ko": "제법이잖아~!"
   },
   {
    "name": "0000_1950004",
    "ko": "좋았어~!\n한꺼번에 격추다!"
   },
   {
    "name": "0000_1960004",
    "ko": "잘하는데~ 폭스!"
   },
   {
    "name": "0000_1970003",
    "ko": "굉장해!\n한 번에 해치웠어!"
   },
   {
    "name": "0000_1980003",
    "ko": "나이스! 폭스!"
   },
   {
    "name": "0000_1990005",
    "ko": "잘했다!\n한 번에 처리했군!"
   },
   {
    "name": "0000_2000005",
    "ko": "폭스!\n실력이 늘었구나!"
   },
   {
    "name": "0000_2010002",
    "ko": "제법인데~ 닥치는 대로\n처리하고 있잖아!"
   },
   {
    "name": "0000_2020004",
    "ko": "우와~ 깔끔하게\n처리하고 있네!"
   },
   {
    "name": "0000_2030003",
    "ko": "그 기세야, 하나도 남김없이\n해치워 버려!"
   },
   {
    "name": "0000_2040005",
    "ko": "좋다, 폭스!\n싹 쓸어버려라!"
   },
   {
    "name": "0000_2080005",
    "ko": "적이 뒤에 있다!"
   },
   {
    "name": "0000_2090004",
    "ko": "폭스!\n뒤에서 적이 와!"
   },
   {
    "name": "0000_2100002",
    "ko": "폭스!\n뒤에서 노리고 있다고."
   },
   {
    "name": "0000_2110003",
    "ko": "뒤에 적이 붙었어.\n조심해, 폭스."
   },
   {
    "name": "0000_2160005",
    "ko": "폭스, 옆이다!"
   },
   {
    "name": "0000_3000001",
    "ko": "전 기체 귀환!\n일단 순조로웠군!"
   },
   {
    "name": "0000_3010005",
    "ko": "수고했다. 다들 실력은\n녹슬지 않은 모양이구나."
   },
   {
    "name": "0000_3230001",
    "ko": "전 기체 귀환\n시작은 이 정도면 됐겠지."
   },
   {
    "name": "0000_3240005",
    "ko": "다들 잘했다.\n일단 올라와 주게."
   },
   {
    "name": "0000_3460001",
    "ko": "전 기체 귀환. 일단 이 정도인가."
   },
   {
    "name": "0000_3470005",
    "ko": "수고했다, 다들\n브리핑 룸으로 올라와 주게."
   },
   {
    "name": "0000_3690001",
    "ko": "휴… 일단 귀환은 했군."
   },
   {
    "name": "0000_3700005",
    "ko": "무슨 일이냐?\n실력이 좀 무뎌졌나?"
   },
   {
    "name": "0000_3920001",
    "ko": "이런…\n엄청난 적이 나타난 모양이군."
   },
   {
    "name": "0000_3930005",
    "ko": "다들 정비가 끝나면\n바로 브리핑이다."
   },
   {
    "name": "0160_0010004",
    "ko": "적 실드 분석 완료!\n모니터에 표시할게!"
   },
   {
    "name": "0160_0020002",
    "ko": "이봐이봐, 안돌프\n흉내라도 내는 거냐?"
   },
   {
    "name": "0160_0030016",
    "ko": "바, 바보 취급하지 마라~\n본때를 보여 주마~"
   },
   {
    "name": "0160_0070005",
    "ko": "손바닥이다!\n손바닥을 노려라!"
   },
   {
    "name": "0160_0080002",
    "ko": "폭스! 꾸물거리고\n있지 말라고!"
   },
   {
    "name": "0160_0090005",
    "ko": "폭스! 뭘 그리\n애먹고 있는 거냐!"
   },
   {
    "name": "0160_0100016",
    "ko": "와하하하하! 죽어라!"
   },
   {
    "name": "0160_0110016",
    "ko": "하하하!\n고작 그 정도냐!"
   },
   {
    "name": "0160_0130016",
    "ko": "크윽, 아직이다~"
   },
   {
    "name": "0160_0140016",
    "ko": "그런 공격은 안 통한다!"
   },
   {
    "name": "0160_0170002",
    "ko": "뭐 하는 놈인지 모르겠지만\n적의가 가득하군…"
   },
   {
    "name": "0160_0190003",
    "ko": "폭스! 레이저\n발사구를 노려!"
   },
   {
    "name": "0160_0200005",
    "ko": "폭스, 침착하게\n잘 노려라!"
   },
   {
    "name": "0160_0220005",
    "ko": "폭스!\n괜찮으냐!"
   },
   {
    "name": "0160_0230005",
    "ko": "힘내라! 폭스!\n지금이 버틸 때다!"
   },
   {
    "name": "0160_0240002",
    "ko": "좋아! 먹히고 있어!"
   },
   {
    "name": "0160_0250005",
    "ko": "좋아, 대미지를\n주고 있다!"
   },
   {
    "name": "0160_0260004",
    "ko": "해냈다~!"
   },
   {
    "name": "0160_0280005",
    "ko": "안심하기엔 아직\n이른 것 같다… 봐라!"
   },
   {
    "name": "0160_0300003",
    "ko": "느껴져… 녀석의 약점은\n가운데 빨간 부분이야."
   },
   {
    "name": "0160_0370005",
    "ko": "조금만 더다!\n힘내라, 폭스!"
   },
   {
    "name": "0160_0380005",
    "ko": "미사일을 요격해라!"
   },
   {
    "name": "0160_0390005",
    "ko": "공격 기회를 놓치지 마라!"
   },
   {
    "name": "0160_1000003",
    "ko": "손바닥을 노려!\n폭스!"
   },
   {
    "name": "0160_1010005",
    "ko": "손의 움직임을 잘 봐라!"
   },
   {
    "name": "0160_1020005",
    "ko": "침착하게\n손의 움직임을 잘 봐라!"
   },
   {
    "name": "0160_1030004",
    "ko": "온다~!"
   },
   {
    "name": "0160_1050004",
    "ko": "꼴좋다~!"
   },
   {
    "name": "0160_1060002",
    "ko": "폭스! 얼른\n해치워 버리자고!"
   },
   {
    "name": "0160_1070004",
    "ko": "우와, 왠지\n기분 나쁜 녀석이네~"
   },
   {
    "name": "0160_1080003",
    "ko": "지금까지\n본 적 없는 느낌이야."
   },
   {
    "name": "0160_1090005",
    "ko": "피해라!\n폭스!"
   },
   {
    "name": "0160_1110005",
    "ko": "적의 공격을 간파해라!"
   },
   {
    "name": "0161_0010001",
    "ko": "전 기체, 함대 포격을 피해\n오이코니 기함을 공격!"
   },
   {
    "name": "0161_0020004",
    "ko": "좋았어, 간다~!"
   },
   {
    "name": "0161_0030003",
    "ko": "잠깐, 슬리피\n무리하지 마!"
   },
   {
    "name": "0161_0040002",
    "ko": "슬리피! 벌써\n적이 뒤에 붙었다고!"
   },
   {
    "name": "0161_0050904",
    "ko": "으악, 큰일이다~"
   },
   {
    "name": "0161_0060904",
    "ko": "고마워, 폭스\n이제 끝인 줄 알았어~"
   },
   {
    "name": "0161_0070002",
    "ko": "너 말이야, 조금도\n성장을 안 했구나."
   },
   {
    "name": "0161_0080904",
    "ko": "아야야야…"
   },
   {
    "name": "0161_0090003",
    "ko": "무리하니까 그렇지.\n조심해!"
   },
   {
    "name": "0161_0100904",
    "ko": "…풀 죽음."
   },
   {
    "name": "0161_0110020",
    "ko": "코네리아군\n제3차 포격 개시."
   },
   {
    "name": "0161_0120020",
    "ko": "안돌프 함대를\n차례로 파괴하고 있습니다."
   },
   {
    "name": "0161_0150004",
    "ko": "전방에 반응 있음!\n뭔가 와!"
   },
   {
    "name": "0161_0160003",
    "ko": "잠항함이야!\n조심해, 폭스!"
   },
   {
    "name": "0161_0170004",
    "ko": "폭탄도 써 봐\n폭스! {6018:10}"
   },
   {
    "name": "0161_0180044",
    "ko": "스타폭스가\n돌격해 옵니다!"
   },
   {
    "name": "0161_0190016",
    "ko": "스타폭스라고~\n에잇, 쓸어버려라!"
   },
   {
    "name": "0161_0300044",
    "ko": "최종 방어선이\n돌파당했습니다~!"
   },
   {
    "name": "0161_0310016",
    "ko": "이 녀석들 괴물이냐?\n젠장~ 뒤는 맡기겠다!"
   },
   {
    "name": "0161_0320044",
    "ko": "에엑, 그럴 수가~"
   },
   {
    "name": "0161_0330020",
    "ko": "적 기함, 포르투나로\n퇴각했습니다."
   },
   {
    "name": "0161_0340002",
    "ko": "오이코니 녀석\n도망쳤군!"
   },
   {
    "name": "0161_0350005",
    "ko": "쫓아라!\n폭스!"
   },
   {
    "name": "0161_0500003",
    "ko": "폭스!\n뒤에서 적이 와!"
   },
   {
    "name": "0161_0520002",
    "ko": "우리도\n질 수 없지!"
   },
   {
    "name": "0161_0550001",
    "ko": "뭐, 뭐야? 이 녀석?\n신형인가?"
   },
   {
    "name": "0161_0560005",
    "ko": "강력한 빔이다!\n조심해라, 폭스!"
   },
   {
    "name": "0161_0570005",
    "ko": "롤링으로 튕겨내라!\n{6030:0} 꾹 누르기"
   },
   {
    "name": "0161_0580004",
    "ko": "폭스! 이거 받아!\n실드가 조금 회복될 거야."
   },
   {
    "name": "0161_0590003",
    "ko": "아래에서 대부대가\n나타났어!"
   },
   {
    "name": "0161_0600004",
    "ko": "전방에 오이코니 함대!\n우글우글해!"
   },
   {
    "name": "0161_0610005",
    "ko": "좋다! 팔코와\n슬리피는 왼쪽 함대를."
   },
   {
    "name": "0161_0620005",
    "ko": "폭스와 크리스탈은 오른쪽을\n쳐라. 단숨에 가라!"
   },
   {
    "name": "0161_0630003",
    "ko": "좋~아, 힘내서\n가 볼까~"
   },
   {
    "name": "0161_0640003",
    "ko": "해냈다!!\n적 전력도 줄었어."
   },
   {
    "name": "0161_0650003",
    "ko": "폭스~\n컨디션 안 좋아?"
   },
   {
    "name": "0163_0010001",
    "ko": "전 기체, 이상 없나?"
   },
   {
    "name": "0163_0050001",
    "ko": "나우스! 녀석의 위치를\n탐색해 줘!"
   },
   {
    "name": "0163_0060020",
    "ko": "알겠습니다."
   },
   {
    "name": "0163_0071003",
    "ko": "예쁜 별이네…\n다음엔 둘이서만 올래?"
   },
   {
    "name": "0163_0081001",
    "ko": "어, 아, 그래…"
   },
   {
    "name": "0163_0090002",
    "ko": "뭘 알콩달콩하고 있어!\n전투 중이라고!"
   },
   {
    "name": "0163_0100902",
    "ko": "큭, 방심했다!\n뒤를 잡혔어!"
   },
   {
    "name": "0163_0110902",
    "ko": "칫\n신세를 졌군…"
   },
   {
    "name": "0163_0120902",
    "ko": "크아아악, 젠장."
   },
   {
    "name": "0163_0130902",
    "ko": "큭, 여기까진가…\n이탈한다!"
   },
   {
    "name": "0163_0140020",
    "ko": "전방에 기지를\n발견했습니다."
   },
   {
    "name": "0163_0150020",
    "ko": "오이코니도\n그곳에 있습니다."
   },
   {
    "name": "0163_0160001",
    "ko": "좋아! 이번에야말로\n녀석을 쓰러뜨린다!"
   },
   {
    "name": "0163_0170004",
    "ko": "여기구나~"
   },
   {
    "name": "0163_0180003",
    "ko": "!? 조심해!\n적이 기다리고 있어!"
   },
   {
    "name": "0163_0190002",
    "ko": "폭스!\n이걸 써!"
   },
   {
    "name": "0163_0200002",
    "ko": "아까 신세는 갚았다!"
   },
   {
    "name": "0163_0210903",
    "ko": "간다~!!"
   },
   {
    "name": "0163_0220904",
    "ko": "으악, 따라오지 마~"
   },
   {
    "name": "0163_0230904",
    "ko": "휴~\n고마워, 폭스."
   },
   {
    "name": "0163_0240904",
    "ko": "아야야!"
   },
   {
    "name": "0163_0250904",
    "ko": "으아악, 이제 안 돼.\n이탈할게."
   },
   {
    "name": "0163_0260003",
    "ko": "찾았다.\n오이코니야!"
   },
   {
    "name": "0163_0270002",
    "ko": "이 자식! 이번에야말로\n놓치지 않겠다!"
   },
   {
    "name": "0163_0280005",
    "ko": "폭스! 이번에야말로\n놓치지 마라!"
   },
   {
    "name": "0163_0290001",
    "ko": "이제 도망 못 간다!\n오이코니!"
   },
   {
    "name": "0163_0300016",
    "ko": "흥… 끈질긴 녀석들이군."
   },
   {
    "name": "0163_1000002",
    "ko": "오이코니 녀석\n어디로 간 거야?"
   },
   {
    "name": "0260_0630004",
    "ko": "젠장~ 이 녀석~!!"
   },
   {
    "name": "0361_0840005",
    "ko": "다들, 방심하지 마라!"
   },
   {
    "name": "0560_1440002",
    "ko": "부딪치지 마라!\n폭스!"
   },
   {
    "name": "0560_1470004",
    "ko": "으악, 피해야 해!"
   },
   {
    "name": "0800_0010003",
    "ko": "적기 격추!"
   },
   {
    "name": "1060_0240002",
    "ko": "온다!\n피해!"
   },
   {
    "name": "1061_0090001",
    "ko": "다들, 방심하지 마!"
   },
   {
    "name": "0000_2200005",
    "ko": "부스트로 쫓아가라\n{6018:6}"
   }
  ]
 }
