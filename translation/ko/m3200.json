[
 {
  "path": [],
  "first": "3200_0010001",
  "entries": [
   {
    "name": "3200_0010001",
    "ko": "다들, 장비는 갖췄지? 지금부터\n본성 내부로 돌입한다!"
   },
   {
    "name": "3200_0020004",
    "ko": "기다려, 폭스!"
   },
   {
    "name": "3200_0030004",
    "ko": "상태가 이상해! 에너지 반응이 커지고 있어!"
   },
   {
    "name": "3200_0040002",
    "ko": "끈질기군!"
   },
   {
    "name": "3200_0050002",
    "ko": "뭐야!?"
   },
   {
    "name": "3200_0060003",
    "ko": "어떻게 된 거야?"
   },
   {
    "name": "3200_0070004",
    "ko": "에너지를 튕겨 내는 실드야…\n블래스터로는 어림도 없어!"
   },
   {
    "name": "3200_0080001",
    "ko": "젠장…"
   },
   {
    "name": "3200_0090005",
    "ko": "다들! 비켜라!"
   },
   {
    "name": "3200_0100003",
    "ko": "페피!"
   },
   {
    "name": "3200_0110020",
    "ko": "손상 심각. 더 이상은\n기체가 버티지 못합니다."
   },
   {
    "name": "3200_0120005",
    "ko": "상관없다! 모든 에너지를 주포로 돌려라!"
   },
   {
    "name": "3200_0130005",
    "ko": "쏴라!!!"
   },
   {
    "name": "3200_0140020",
    "ko": "기체 손상 한계입니다."
   },
   {
    "name": "3200_0150005",
    "ko": "상관없다! 이대로 돌격한다!"
   },
   {
    "name": "3200_0160001",
    "ko": "페피! 죽을 셈이야!"
   },
   {
    "name": "3200_0170005",
    "ko": "너희는 물러나라!"
   },
   {
    "name": "3200_0180001",
    "ko": "페피… …… 설마!"
   },
   {
    "name": "3200_0190005",
    "ko": "여기는 내 몫이다. 너희는\n너희의 몫을 다해라, 폭스."
   },
   {
    "name": "3200_0200003",
    "ko": "페피!"
   },
   {
    "name": "3200_0210004",
    "ko": "그런 말을 해도…!"
   },
   {
    "name": "3200_0220002",
    "ko": "무슨 짓을 하는 거야!! 이 영감탱이!!"
   },
   {
    "name": "3200_0250005",
    "ko": "뭘 하고 있는 거냐! 실드는 금방\n복구된단 말이다!"
   },
   {
    "name": "3200_0260005",
    "ko": "가라! 어서 가지 못할까~!!"
   },
   {
    "name": "3200_0270001",
    "ko": "…다들!!"
   },
   {
    "name": "3200_0280001",
    "ko": "페피가 열어 준 길이야!"
   },
   {
    "name": "3200_0290001",
    "ko": "우리는 우리의 의지로 앞으로 나아간다!"
   },
   {
    "name": "3200_0310001",
    "ko": "그러니까…… 그러니까 다들!!"
   },
   {
    "name": "3200_0320001",
    "ko": "가자아아아아앗!"
   }
  ]
 }
]