   {
    "name": "0000_2080005",
    "ko": "적이 뒤에 있다!"
   },
   {
    "name": "0000_1370005",
    "ko": "포기하지 마라, 폭스!\n너는 지지 않는다!"
   },
   {
    "name": "0000_2040005",
    "ko": "좋다, 폭스!\n싹 쓸어버려라!"
   },
   {
    "name": "0000_0340005",
    "ko": "왜 그러냐 폭스!\n작전을 수행해라!"
   },
   {
    "name": "0000_1990005",
    "ko": "잘했다!\n한 번에 처리했군!"
