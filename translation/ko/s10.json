   {
    "name": "1060_1620004",
    "ko": "질 수 없어~!\n기뢰를 어떻게 좀 해 줘~"
   },
   {
    "name": "1061_0040009",
    "ko": "여차할 땐 우리가\n곁에 있다고~! 크리스탈."
   },
   {
    "name": "1062_0240009",
    "ko": "드디어 피날레가\n가까운 것 같군… 허니."
   },
   {
    "name": "0000_0270009",
    "ko": "어이어이, 들은 얘기랑\n영 딴판인데…"
   },
   {
    "name": "1061_0560009",
    "ko": "다음엔 좀 더 제대로 된\n곳에서 함께하고 싶군."
   },
   {
    "name": "0000_0260009",
    "ko": "정말이지, 한심하군."
   },
   {
    "name": "0000_0250009",
    "ko": "어딜 보고 있는 거냐!"
   },
   {
    "name": "0000_0200009",
    "ko": "여우! 죽고 싶냐!"
   },
   {
    "name": "0000_0240009",
    "ko": "핫, 사냥감을 가로채다니\n매너도 모르는군."
   },
   {
    "name": "1060_1500002",
    "ko": "내가 다가가서 공격한다!\n폭스! 엄호해!"
   },
   {
    "name": "0000_0240002",
    "ko": "내 사냥감에 손대지 마\n폭스!!"
   },
   {
    "name": "1061_0050002",
    "ko": "벽이 조여 온다!"
   },
   {
    "name": "1060_1290002",
    "ko": "흉포해 보이는\n낯짝을 하고 있군!"
   },
   {
    "name": "1060_1480002",
    "ko": "기뢰다! 쏴라~!\n폭발시키지 마!"
   },
   {
    "name": "1060_0120002",
    "ko": "장갑 아래에도 『프로그램』을\n쏘아 넣을 수 없겠어!"
   },
   {
    "name": "0000_0270002",
    "ko": "컨디션이 안 좋아 보이는데\n폭스."
   },
   {
    "name": "0000_0260002",
    "ko": "괜찮냐\n폭스!"
   },
   {
    "name": "0000_1310002",
    "ko": "괜찮냐, 폭스!\n당하면 안 된다!"
