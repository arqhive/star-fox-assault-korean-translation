   {
    "name": "1060_0390002",
    "ko": "괜찮냐? 폭스!\n어떻게든 버텨!"
   },
   {
    "name": "1062_0290002",
    "ko": "저 녀석들\n폼 잡기는…"
   },
   {
    "name": "1061_0320002",
    "ko": "온갖 수를 써서\n길을 막겠다는 거군…"
   },
   {
    "name": "0000_3420002",
    "ko": "갈 수 있어!"
   },
   {
    "name": "1061_0400902",
    "ko": "아야야야!"
   },
   {
    "name": "1060_0420002",
    "ko": "지금이다, 폭스!\n프로그램을 쏘아 넣어!"
   },
   {
    "name": "1060_1060002",
    "ko": "꽤나 화가 난 모양이야.\n조심해!"
   },
   {
    "name": "1060_0330002",
    "ko": "포기해라!"
   },
   {
    "name": "1060_1530002",
    "ko": "젠장, 한계다!"
   },
   {
    "name": "1062_0210002",
    "ko": "큭, 이럴 수가"
