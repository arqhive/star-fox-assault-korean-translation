   {
    "name": "1061_0390902",
    "ko": "끈질기군!\n이 녀석들!"
   },
   {
    "name": "0000_1930002",
    "ko": "굉장한데!\n한 번에 해치웠어!"
   },
   {
    "name": "1060_1110002",
    "ko": "엄청난 공격이다.\n맞지 마라!"
   },
   {
    "name": "0000_1320002",
    "ko": "꽤 당했구나.\n폭스, 괜찮냐?"
