   {
    "name": "0000_4130004",
    "ko": "조마조마하네~"
   },
   {
    "name": "1061_0480004",
    "ko": "폭스\n이거 받아!"
   },
   {
    "name": "1061_0470004",
    "ko": "폭스\n실드를 회복해!"
