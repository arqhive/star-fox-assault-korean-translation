[
 {
  "path": [],
  "first": "1021_0030001",
  "entries": [
   {
    "name": "1021_0030001",
    "ko": "팔코…!"
   },
   {
    "name": "1021_0040001",
    "ko": "우리를 추적하는 녀석이 있다…"
   },
   {
    "name": "1021_0050002",
    "ko": "뭐!?"
   },
   {
    "name": "1021_0080001",
    "ko": "울프냐!?"
   },
   {
    "name": "1021_0060010",
    "ko": "흥, 너희가\n용케 여기까지 왔군."
   },
   {
    "name": "1021_0070002",
    "ko": "뭐라고오!"
   },
   {
    "name": "1021_0090009",
    "ko": "크리스탈\n여기서부터는 내가 방패가 되어 주지!"
   },
   {
    "name": "1021_0100003",
    "ko": "팬서…"
   },
   {
    "name": "1021_0110004",
    "ko": "전부 합쳐 겨우 7기인가~…\n그래도… 4기보다는 낫네!"
   },
   {
    "name": "1021_0120008",
    "ko": "살아남았나 보군."
   },
   {
    "name": "1021_0130001",
    "ko": "간신히."
   },
   {
    "name": "1021_0140008",
    "ko": "간다!"
   },
   {
    "name": "1021_0150001",
    "ko": "좋아!"
   }
  ]
 },
 {
  "path": [],
  "first": "1032_0010001",
  "entries": [
   {
    "name": "1032_0010001",
    "ko": "…………"
   },
   {
    "name": "1032_0020002",
    "ko": "이 녀석이…"
   },
   {
    "name": "1032_0030003",
    "ko": "마더…"
   },
   {
    "name": "1032_0040048",
    "ko": "폭스…"
   },
   {
    "name": "1032_0050001",
    "ko": "!?"
   },
   {
    "name": "1032_0060048",
    "ko": "폭스~ 이제 그만\n포기하는 게 어떻노~"
   },
   {
    "name": "1032_0080001",
    "ko": "피그마…!"
   },
   {
    "name": "1032_0100002",
    "ko": "네놈! 죽었을 텐데!?"
   },
   {
    "name": "1032_0120047",
    "ko": "스타폭스 제군\n패배를 받아들이게."
   },
   {
    "name": "1032_0130004",
    "ko": "페… 페퍼 장군!?"
   },
   {
    "name": "1032_0140046",
    "ko": "손을 떼라. 이건 희생이 아니다.\n새로운 진화의 형태다."
   },
   {
    "name": "1032_0150003",
    "ko": "페피까지! 그만해!"
   },
   {
    "name": "1032_0160002",
    "ko": "어떻게 된 거야!?"
   },
   {
    "name": "1032_0170023",
    "ko": "폭스…"
   },
   {
    "name": "1032_0180001",
    "ko": "아버지!?……"
   },
   {
    "name": "1032_0190023",
    "ko": "이제 충분하다…\n더 이상 상처받을 일은 없다…"
   },
   {
    "name": "1032_0200001",
    "ko": "…………"
   },
   {
    "name": "1032_0210023",
    "ko": "함께 살자."
   },
   {
    "name": "1032_0220002",
    "ko": "폭스!! 속지 마!\n네 아버지는…!"
   },
   {
    "name": "1032_0230001",
    "ko": "알고 있어!"
   },
   {
    "name": "1032_0240001",
    "ko": "아버지는… 내 아버지는\n그런 말은 하지 않아!!"
   },
   {
    "name": "1032_0250004",
    "ko": "그렇구나! 마더는 침식할 때 흡수한\n모든 정보를 이용하고 있는 거야!"
   },
   {
    "name": "1032_0270023",
    "ko": "폭스…\n더 이상 싸울 필요는 없다. 함께…"
   },
   {
    "name": "1032_0280047",
    "ko": "사세. 우리와 함께…"
   },
   {
    "name": "1032_0290048",
    "ko": "사는 기다… 하나가 되는 기다…"
   },
   {
    "name": "1032_0300008",
    "ko": "망설이지 마라!\n여차할 땐 주저 없이 행동해라!"
   },
   {
    "name": "1032_0310001",
    "ko": "다들!\n『자멸 프로그램』을 쏘아 넣는다!"
   },
   {
    "name": "1032_0320001",
    "ko": "스타폭스, 전투 개시!"
   }
  ]
 },
 {
  "path": [],
  "first": "1033_1000001",
  "entries": [
   {
    "name": "1033_1000001",
    "ko": "받아라아아앗!!!"
   },
   {
    "name": "1033_0010001",
    "ko": "어떠냐…?"
   },
   {
    "name": "1033_1010004",
    "ko": "모르겠어… 하지만…"
   },
   {
    "name": "1033_0040003",
    "ko": "………?"
   },
   {
    "name": "1033_0050003",
    "ko": "…이상해, 폭스!"
   },
   {
    "name": "1033_0060015",
    "ko": "…든 것은 나를 위해…\n…우주의 만물은 나… 위해… 한다."
   },
   {
    "name": "1033_0070001",
    "ko": "…뭐?!"
   },
   {
    "name": "1033_0080015",
    "ko": "모든 것은 나를 위해\n이 우주의 만물은 나를 위해 존재한다."
   },
   {
    "name": "1033_0090015",
    "ko": "나를 따르라! 내게 모든 것을 바쳐라!"
   },
   {
    "name": "1033_1020002",
    "ko": "뭐… 뭐야!"
   },
   {
    "name": "1033_1030003",
    "ko": "『자멸 프로그램』은 먹히고 있는 거야!?"
   },
   {
    "name": "1033_1060004",
    "ko": "먹히고 있을 텐데…\n마더가 억지로 억누르고 있어!"
   },
   {
    "name": "1033_1070004",
    "ko": "안 돼. 지금 놓치면\n항체를 만들어 낼 거야!"
   },
   {
    "name": "1033_0190001",
    "ko": "………!"
   },
   {
    "name": "1033_0200002",
    "ko": "폭스!"
   },
   {
    "name": "1033_0210004",
    "ko": "폭스!"
   },
   {
    "name": "1033_0220003",
    "ko": "폭스!"
   },
   {
    "name": "1033_0230001",
    "ko": "녀석을 쓰러뜨리고\n무슨 일이 있어도 프로그램을 가동시킨다!!"
   },
   {
    "name": "1033_0240001",
    "ko": "간다!! 마지막 싸움이다!!"
   }
  ]
 },
 {
  "path": [],
  "first": "1061_0020008",
  "entries": [
   {
    "name": "1061_0020008",
    "ko": "우리는 뒤에서\n솜씨 구경이나 해 볼까!"
   },
   {
    "name": "0000_0270008",
    "ko": "괜찮냐?\n너덜너덜하잖아."
   },
   {
    "name": "1061_0530008",
    "ko": "그래, 녀석들도 꽤\n애먹이는군."
   },
   {
    "name": "1061_0550008",
    "ko": "제법 큰소리를 치는군.\n넌 앞이나 봐."
   },
   {
    "name": "0000_0260008",
    "ko": "어이어이… 꼴이 그게 뭐냐."
   },
   {
    "name": "1062_0280008",
    "ko": "따라와라!\n벌레 놈들!!"
   },
   {
    "name": "0000_0200008",
    "ko": "네 이놈! 해보자는 거냐!"
   },
   {
    "name": "0000_0240008",
    "ko": "이 몸의 사냥감인 줄\n알고 한 짓이냐?"
   },
   {
    "name": "1061_0150008",
    "ko": "꽥꽥 시끄럽다\n개구리."
   },
   {
    "name": "1062_0260008",
    "ko": "레온, 팬서\n간다!"
   },
   {
    "name": "1062_0250008",
    "ko": "우리가 유인한다.\n너희는 마더를 쓰러뜨려!"
   },
   {
    "name": "0000_0250008",
    "ko": "정신 똑바로 차려!!"
   },
   {
    "name": "1060_1580003",
    "ko": "기체가…! 폭스…\n마더를 부탁해…"
   },
   {
    "name": "0000_0260003",
    "ko": "괜찮아!? 폭스!"
   },
   {
    "name": "1060_0290003",
    "ko": "아앗!"
   },
   {
    "name": "1060_0020003",
    "ko": "저 장갑 때문에\n『자멸 프로그램』을 쏘아 넣을 수 없어…"
   },
   {
    "name": "1062_0050003",
    "ko": "위험해!"
   },
   {
    "name": "1060_0230003",
    "ko": "위험해!\n마더 정면에서 떨어져!"
   },
   {
    "name": "1061_0340003",
    "ko": "잘하고 있어, 폭스."
   },
   {
    "name": "0000_1270003",
    "ko": "받아, 폭스!\n아까의 답례야!"
   },
   {
    "name": "1060_0280003",
    "ko": "꺄아아악"
   },
   {
    "name": "1060_1560003",
    "ko": "꺄악! 기뢰를\n부탁해! 폭스!"
   },
   {
    "name": "0000_1160903",
    "ko": "큭! 맞았어!"
   },
   {
    "name": "1060_1310003",
    "ko": "여기가 고비야!\n간다!"
   },
   {
    "name": "1061_0570003",
    "ko": "여기서 지면\n다음도 없어."
   },
   {
    "name": "0000_3200003",
    "ko": "이쪽도 괜찮아!"
   },
   {
    "name": "1060_0340003",
    "ko": "이 녀석!"
   },
   {
    "name": "1060_1570003",
    "ko": "이대로는 다가갈 수 없어!\n기뢰를 파괴해!!"
   },
   {
    "name": "1060_0350003",
    "ko": "이건 어때!"
   },
   {
    "name": "0000_0250003",
    "ko": "정신 차려\n폭스!"
   },
   {
    "name": "1062_0200003",
    "ko": "엄청난 수야…"
   },
   {
    "name": "0000_1970003",
    "ko": "굉장해!\n한 번에 해치웠어!"
   },
   {
    "name": "1060_1380003",
    "ko": "그 기세야. 지지 마\n폭스!"
   },
   {
    "name": "0000_2030003",
    "ko": "그 기세야, 하나도 남김없이\n해치워 버려!"
   },
   {
    "name": "1060_0190003",
    "ko": "속지 마!\n이 기세야, 폭스."
   },
   {
    "name": "0000_0200003",
    "ko": "잠깐!\n장난은 그만해!"
   },
   {
    "name": "0000_0240003",
    "ko": "잠깐! 내 사냥감이야!"
   },
   {
    "name": "1060_1120003",
    "ko": "일단 피해! 버티면\n기회도 생길 거야!"
   },
   {
    "name": "1062_0100003",
    "ko": "일단 피하는 거야!!"
   },
   {
    "name": "1060_0130003",
    "ko": "어딘가 약점이라도 있으면…"
   },
   {
    "name": "0000_3890003",
    "ko": "그럭저럭 날 수 있어."
   },
   {
    "name": "1060_1340003",
    "ko": "겁먹지 마! 마더는\n우리를 무서워하고 있어!"
   },
   {
    "name": "1060_1490003",
    "ko": "또 기뢰를 내보냈어!\n조심해!"
   },
   {
    "name": "1060_1460003",
    "ko": "또 뭔가\n꾸미고 있어!"
   },
   {
    "name": "1060_1590003",
    "ko": "해냈다~!! 우리\n좋은 콤비네!"
   },
   {
    "name": "1060_0490003",
    "ko": "알고는 있어도\n괴롭네…"
   },
   {
    "name": "1060_1200003",
    "ko": "번개야!\n잘 봐!!"
   },
   {
    "name": "0000_1980003",
    "ko": "나이스! 폭스!"
   },
   {
    "name": "0000_0270003",
    "ko": "폭스\n힘내!!"
   },
   {
    "name": "0000_0340003",
    "ko": "폭스\n농땡이 치고 있네…"
   },
   {
    "name": "1062_0310003",
    "ko": "폭스…"
   },
   {
    "name": "1060_0010003",
    "ko": "폭스… 마더를 봐."
   },
   {
    "name": "1060_0400003",
    "ko": "폭스, 물러설 곳이 없어\n힘내!!"
   },
   {
    "name": "1061_0250903",
    "ko": "폭스, 고마워."
   },
   {
    "name": "0000_1350003",
    "ko": "폭스, 정신 차려!\n포기하지 마!"
   },
   {
    "name": "0000_0220003",
    "ko": "폭스~!!"
   },
   {
    "name": "1060_1550003",
    "ko": "폭스!\n엄호를 부탁해!"
   },
   {
    "name": "1060_0100003",
    "ko": "폭스!\n저 빛나는 부분을 파괴해!"
   },
   {
    "name": "1060_0090003",
    "ko": "폭스!\n저 빨간 부분을 파괴해!"
   },
   {
    "name": "1061_0380003",
    "ko": "폭스!\n팔코가 위험해!"
   },
   {
    "name": "1060_1660003",
    "ko": "폭스!!\n마무리를!!"
   },
   {
    "name": "1062_0030003",
    "ko": "페피를 위해서라도\n반드시 결판을 내야 해!"
   },
   {
    "name": "1061_0080003",
    "ko": "전방의 적 반응 증대!"
   },
   {
    "name": "0000_0330903",
    "ko": "도와준 답례야."
   },
   {
    "name": "0000_3660003",
    "ko": "문제없어!"
   },
   {
    "name": "0000_3430003",
    "ko": "괜찮아!"
   },
   {
    "name": "0000_4120003",
    "ko": "돌아갈 만큼밖에 없어."
   },
   {
    "name": "1060_1030003",
    "ko": "약점은 반드시 있어!\n마더의 반응을 잘 봐!"
   },
   {
    "name": "1061_0240903",
    "ko": "뒤에 적이!\n도와줘, 폭스!"
   },
   {
    "name": "0000_2110003",
    "ko": "뒤에 적이 붙었어.\n조심해, 폭스."
   },
   {
    "name": "1060_1180003",
    "ko": "조심해!\n뭔가 와!"
   },
   {
    "name": "0000_1360003",
    "ko": "지지 마, 폭스!\n같이 살아남는 거야!"
   },
   {
    "name": "0000_0290004",
    "ko": "적 실드 분석 완료\n모니터에 표시할게."
   },
   {
    "name": "1060_1470004",
    "ko": "기뢰야!\n폭발을 조심해!"
   },
   {
    "name": "0000_0260004",
    "ko": "괜찮아!?\n폭스!"
   },
   {
    "name": "1062_0130004",
    "ko": "적 반응! 또 앞에서야!"
   },
   {
    "name": "1062_0110004",
    "ko": "적 반응! 앞에서 와!"
   },
   {
    "name": "1061_0130904",
    "ko": "아야야야야!"
   },
   {
    "name": "1060_0360004",
    "ko": "맞아라!"
   },
   {
    "name": "0000_0240004",
    "ko": "앗! 내가\n노리고 있었는데!"
   },
   {
    "name": "0000_0250004",
    "ko": "으악\n너무해, 폭스!"
   },
   {
    "name": "1062_0090004",
    "ko": "으아아아아악"
   },
   {
    "name": "0000_3440004",
    "ko": "괜찮은 거 아냐?"
   },
   {
    "name": "1060_1630004",
    "ko": "으윽… 폭스…\n너한테 맡길게~!"
   },
   {
    "name": "0000_2020004",
    "ko": "우와~ 깔끔하게\n처리하고 있네!"
   },
   {
    "name": "0000_1960004",
    "ko": "잘하는데~ 폭스!"
   },
   {
    "name": "1060_0300004",
    "ko": "으아아아악!"
   },
   {
    "name": "1060_0250004",
    "ko": "으아아~\n또 온다~!"
   },
   {
    "name": "1061_0110904",
    "ko": "으악, 끈질기다\n이 녀석들."
   },
   {
    "name": "1061_0490004",
    "ko": "합, 합체했어!?"
   },
   {
    "name": "1060_0030004",
    "ko": "젠장~ 저 비늘이\n자꾸 방해하네~!!"
   },
   {
    "name": "1060_0040004",
    "ko": "젠장~ 저 날개가\n자꾸 방해하네~!!"
   },
   {
    "name": "1062_0010004",
    "ko": "이, 이렇게 좁은 곳을\n이런 속도로~…"
   },
   {
    "name": "1060_0370004",
    "ko": "이 녀석!"
   },
   {
    "name": "1060_0310004",
    "ko": "이 녀석이!"
   },
   {
    "name": "1060_1130004",
    "ko": "여기까지 와서 당할\n수는 없어~"
   },
   {
    "name": "1061_0100004",
    "ko": "이 앞에\n뭐가 있을까…"
   },
   {
    "name": "0000_0330904",
    "ko": "이건 작은 답례야!"
   },
   {
    "name": "0000_3900004",
    "ko": "이 정도면 됐지."
   },
   {
    "name": "0000_0270004",
    "ko": "폭스가 저러는 건\n못 보겠어~"
   },
   {
    "name": "0000_1330004",
    "ko": "그 체력으로 괜찮겠어?\n폭스~…"
   },
   {
    "name": "1060_1170004",
    "ko": "추적 성능은 별로야!\n떼어내!"
   },
   {
    "name": "0000_3210004",
    "ko": "괜찮아, 괜찮아!"
   },
   {
    "name": "1061_0360004",
    "ko": "괜찮아, 폭스."
   },
   {
    "name": "1062_0070004",
    "ko": "히익~ 부딪친다~"
   },
   {
    "name": "0000_0340004",
    "ko": "너무해, 폭스!\n우리한테만 시킬 셈이야?"
   },
   {
    "name": "1060_1610004",
    "ko": "히야~!! 엄호\n부탁해! 폭스~!"
