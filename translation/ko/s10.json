   {
    "name": "1061_0120904",
    "ko": "폭스! 미안\n뒤 좀 부탁해~"
   },
   {
    "name": "1061_0300004",
    "ko": "전방에 적 반응 확인!"
   },
   {
    "name": "1062_0190004",
    "ko": "전방에 적 반응!\n폭, 폭스!!!"
   },
   {
    "name": "1061_0140904",
    "ko": "살았어, 폭스."
