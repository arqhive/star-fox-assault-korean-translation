   {
    "name": "0000_4140001",
    "ko": "휴…… 일단 전 작전 완료."
   },
   {
    "name": "0000_3180001",
    "ko": "전 기체 상황 확인!"
   },
   {
    "name": "1062_0040001",
    "ko": "전방에 장애물!\n다들! 주의해라!"
