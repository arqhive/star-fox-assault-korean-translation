   {
    "name": "1061_0090001",
    "ko": "다들, 방심하지 마!"
   },
   {
    "name": "1060_0080001",
    "ko": "다들 신경 쓰지 마!\n공격이다!"
   },
   {
    "name": "0000_3450001",
    "ko": "좋아…… 전 작전 완료!"
   },
   {
    "name": "0000_3220001",
    "ko": "좋아…… 전 작전 완료다!"
   },
   {
    "name": "1060_0060001",
    "ko": "좋아\n우선 장갑을 파괴한다!"
