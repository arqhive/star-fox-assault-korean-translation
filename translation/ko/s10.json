   {
    "name": "1062_0230002",
    "ko": "뭐라고…!"
   },
   {
    "name": "1061_0410902",
    "ko": "휴, 고맙다\n폭스."
   },
   {
    "name": "1060_0050002",
    "ko": "헷, 방해되는 건\n부숴 버리면 그만이지!"
