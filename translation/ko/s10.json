   {
    "name": "0000_1940002",
    "ko": "제법이잖아~!"
   },
   {
    "name": "0000_2010002",
    "ko": "제법인데~ 닥치는 대로\n처리하고 있잖아!"
   },
   {
    "name": "1060_0200002",
    "ko": "좋았어~!!\n조금만 더야, 폭스."
   },
   {
    "name": "1060_1300002",
    "ko": "좋아! 이번에야말로\n결판을 내 주마!"
   },
   {
    "name": "0000_3190002",
    "ko": "오케이다!"
   },
   {
    "name": "0000_3650002",
    "ko": "올라잇!"
   },
   {
    "name": "0000_0200002",
    "ko": "큭! 적과 아군도\n구별 못 하냐!"
   },
   {
    "name": "0000_0250002",
    "ko": "방해다, 비켜!"
   },
   {
    "name": "1060_1520002",
    "ko": "젠장! 이래선\n다가갈 수가 없어!"
   },
   {
    "name": "0000_0220002",
    "ko": "폭스~!!"
   },
   {
    "name": "1060_1510002",
    "ko": "폭스!\n기뢰를 처리해 줘!!"
   },
   {
    "name": "1061_0460002",
    "ko": "폭스!\n이걸 건네 두지!"
   },
   {
    "name": "0000_0340002",
    "ko": "폭스!\n뭐 하는 거야!"
   },
   {
    "name": "0000_2100002",
    "ko": "폭스!\n뒤에서 노리고 있다고."
   },
   {
    "name": "1061_0580002",
    "ko": "레온! 뒤에서\n쏘지나 마라!"
