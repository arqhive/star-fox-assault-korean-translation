   {
    "name": "1060_0320002",
    "ko": "받아라!"
   },
   {
    "name": "0561_0240902",
    "ko": "한 방 먹었군…"
   },
   {
    "name": "1060_0240002",
    "ko": "온다!\n피해!"
   },
   {
    "name": "1060_1190002",
    "ko": "온다! 번개다!"
   },
   {
    "name": "1060_0260002",
    "ko": "크아악!"
   },
   {
    "name": "1060_0530002",
    "ko": "흥, 페피가\n약한 모습을 보일 리가!!"
