   {
    "name": "1060_0160048",
    "ko": "바보 아이가… 이제 그만\n포기하래이~"
   },
   {
    "name": "1060_0500050",
    "ko": "스타폭스가 이길\n확률은 0%입니다…"
   },
   {
    "name": "1060_0540023",
    "ko": "폭스… 너에게 새로운\n세계를 보여 주마…"
   },
   {
    "name": "1060_0460023",
    "ko": "폭스, 이제 싸울\n필요 따윈 없단다."
   },
   {
    "name": "1060_0470046",
    "ko": "소용없다…\n손을 떼라, 너희들…"
   },
   {
    "name": "1060_0570047",
    "ko": "하나가 되어 진화한다…"
   },
   {
    "name": "1060_0581023",
    "ko": "동료들이여…"
   },
   {
    "name": "1060_0070047",
    "ko": "다시 생각하게, 폭스…!"
   },
   {
    "name": "1060_0590023",
    "ko": "진화의 양식이 될 자들이여…"
   },
   {
    "name": "1060_0590046",
    "ko": "진화의 양식이 될 자들이여…"
