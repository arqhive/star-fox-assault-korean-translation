  "entries": [
   {
    "name": "0341_0010008",
    "ko": "제법이군, 폭스!"
   },
   {
    "name": "0341_0020001",
    "ko": "울프… 부탁이다!\n피그마를 넘겨줘!"
   },
   {
    "name": "0341_0030008",
    "ko": "스타 울프의 수치하고는 연을 끊었다!\n이 구역에 왔더라도 부하들이 쫓아냈을 거다."
   },
   {
    "name": "0341_0040003",
    "ko": "그럴 수가… 그럼 피그마는 어디로?"
   },
   {
    "name": "0341_0050009",
    "ko": "휘유~ 소문대로 아름답군… 네가 크리스탈이구나\n나는 팬서 카루소. 운명적인 만남에 건배"
   },
   {
    "name": "0341_0060002",
    "ko": "뭐야? 이 바보는?"
   },
   {
    "name": "0341_0070009",
    "ko": "닥쳐라, 새"
   },
   {
    "name": "0341_0080002",
    "ko": "뭐라고오!!"
   },
   {
    "name": "0341_0090003",
    "ko": "그런 건 됐으니까\n피그마가 있는 곳을 알려 줘!"
   },
   {
    "name": "0341_0100009",
    "ko": "어쩔 수 없군. 아름다운 아가씨의 부탁이니\n통신 기록에서 피치나가 어쩌고 했다더군."
   },
   {
    "name": "0341_0110008",
    "ko": "말이 너무 많다!\n팬서! 레온! 간다!!"
   },
   {
    "name": "0341_0120008",
    "ko": "폭스, 기억해 둬라!\n널 쓰러뜨리는 건 이 스타 울프다!!"
   }
  ]
 },
