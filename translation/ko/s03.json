   {
    "name": "0361_0550004",
    "ko": "콜로니 안은 문제없어\n안심해도 돼, 폭스"
   },
   {
    "name": "0361_0570004",
    "ko": "적 공격 때문에\n전송 장치에 못 다가가겠어!"
   },
   {
    "name": "0361_0580004",
    "ko": "원래 폭스가\n콜로니 담당이었잖아~"
   },
   {
    "name": "0361_0590004",
    "ko": "전송 장치가\n아직 남아 있는데~"
   },
   {
    "name": "0361_0650002",
    "ko": "여기는 팔코!\n우주에 적 증원이 나타났다!"
   },
   {
    "name": "0361_0660003",
    "ko": "큰일이야! 우주 공간에\n적 증원이 나타났어!"
   },
   {
    "name": "0361_0680005",
    "ko": "폭스, 우주 공간에\n새로운 적이다!"
   },
   {
    "name": "0361_0700008",
    "ko": "고작 여우 주제에\n우쭐대지 마라!"
   },
   {
    "name": "0361_0700009",
    "ko": "날 진심으로 화나게 하다니\n목숨 아까운 줄 모르는군!"
   },
   {
    "name": "0361_0700010",
    "ko": "내가 누군 줄 아는 거냐!"
   },
   {
    "name": "0361_0710008",
    "ko": "이 내가 당하다니…"
   },
   {
    "name": "0361_0710009",
    "ko": "이럴 수가…!?\n이 내가…!?"
   },
   {
    "name": "0361_0710010",
    "ko": "이 내가…\n이 내가아~!!"
   },
   {
    "name": "0361_0730008",
    "ko": "왜 그러냐!\n벌써 끝이냐!?"
   },
   {
    "name": "0361_0740008",
    "ko": "뭐라고!?"
   },
   {
    "name": "0361_0740009",
    "ko": "제법이군!"
   },
   {
    "name": "0361_0740010",
    "ko": "건방진 여우 놈!"
   },
   {
    "name": "0361_0800005",
    "ko": "작전 중에는 왼쪽 위의\n세력 게이지를 주의해라!"
   },
   {
    "name": "0361_0810005",
    "ko": "게이지는 콜로니 주변의\n적 세력 상황을 나타낸다."
   },
   {
    "name": "0361_0820005",
    "ko": "적에게 제공권을 빼앗기면\n작전 수행이 불가능해진다."
   },
   {
    "name": "0361_0830005",
    "ko": "제공권을 빼앗길 것 같으면\n우주의 적을 쓰러뜨려 줘!"
   },
   {
    "name": "0361_0840005",
    "ko": "다들 방심하지 마라!"
   },
   {
    "name": "0361_0850005",
    "ko": "작전 중에는\n세력 게이지를 주의해라!"
   },
   {
    "name": "0361_0860005",
    "ko": "제공권을 빼앗기기 전에\n타깃을 파괴해라!"
   },
   {
    "name": "0361_0870005",
    "ko": "게이지가 한계에 닿기 전에\n타깃을 파괴해라!"
   },
   {
    "name": "0361_0880005",
    "ko": "게이지 상황이 나쁠 땐\n우주의 적을 쓰러뜨려 줘."
   },
   {
    "name": "0361_0890020",
    "ko": "전송 장치 파괴를\n확인했습니다."
   },
   {
    "name": "0361_0900005",
    "ko": "좋다, 폭스. 남은\n전송 장치는 얼마 없다!"
   },
   {
    "name": "0361_0910005",
    "ko": "순조롭구나, 폭스!\n그 기세다!"
   },
   {
    "name": "0361_0920005",
    "ko": "음!\n역시다! 폭스!"
   },
   {
    "name": "0361_0950004",
    "ko": "남은 전송 장치는 더\n위층에 있는 것 같아."
   },
   {
    "name": "0361_0960005",
    "ko": "엘리베이터가 있을 거다\n그걸 찾아라!"
   },
   {
    "name": "0361_0980032",
    "ko": "이놈들아!\n엘리베이터를 사수한다!"
   },
   {
    "name": "0361_1000020",
    "ko": "엘리베이터 작동을\n확인했습니다."
   },
   {
    "name": "0361_1030002",
    "ko": "살았다!\n미안하다, 폭스!"
   },
   {
    "name": "0361_1040003",
    "ko": "덕분에 살았어\n고마워, 폭스"
   },
   {
    "name": "0361_1060005",
    "ko": "휴~ 하마터면 우주를\n제압당할 뻔했구먼!"
   },
   {
    "name": "0361_1080005",
    "ko": "위에서 오는 공격을\n조심해라!"
   },
   {
    "name": "0361_1090004",
    "ko": "적 격파!"
   },
   {
    "name": "0361_1100005",
    "ko": "운석을 조심해라…!"
   },
   {
    "name": "0361_1110001",
    "ko": "여기가 콜로니의\n최상층인가…"
   },
   {
    "name": "0361_1120004",
    "ko": "적의 매복을\n조심해!"
   },
   {
    "name": "0361_1190034",
    "ko": "젠장! 이런 데까지\n쳐들어오다니~!"
   },
   {
    "name": "0361_1200013",
    "ko": "얘들아, 덤벼라~!"
   },
   {
    "name": "0361_1260013",
    "ko": "젠장!\n두고 보자!"
   },
   {
    "name": "0361_1270032",
    "ko": "받아라!"
   },
   {
    "name": "0361_1280027",
    "ko": "크악! 당했다!"
   },
   {
    "name": "0361_1290034",
    "ko": "뭐 이런 놈들이 다 있어!"
   },
   {
    "name": "0361_1300035",
    "ko": "이렇게 강하다니!"
   },
   {
    "name": "0361_1310033",
    "ko": "젠장!\n감히!"
   },
   {
    "name": "0361_1320034",
    "ko": "크아아~!"
   },
   {
    "name": "0361_1390027",
    "ko": "두목이 돌아올 때까지\n무슨 일이 있어도 버텨라."
   },
   {
    "name": "0361_1420002",
    "ko": "새로운 적 전함 발견\n지금부터 요격한다."
   },
   {
    "name": "0361_1430003",
    "ko": "적 증원 확인\n지금부터 응전할게."
   },
   {
    "name": "0361_1440005",
    "ko": "폭스! 적 증원이다\n우주로 요격하러 가 줘!"
   },
   {
    "name": "0361_1450005",
    "ko": "점프로 잘\n피해라! {6018:6}"
   },
   {
    "name": "0361_1460002",
    "ko": "지금은 괜찮다\n슬리피를 봐 줘."
   },
   {
    "name": "0361_1470002",
    "ko": "피그마 녀석은\n콜로니에 없는 건가?"
   },
   {
    "name": "0361_1480003",
    "ko": "지금은 괜찮아\n슬리피를 도와줘."
   },
   {
    "name": "0361_1490003",
    "ko": "피그마는 없는 걸까?\n나는 느껴지지 않는데…"
   },
   {
    "name": "0361_1500004",
    "ko": "꽤 복잡한 콜로니라서\n길을 잃을 것 같아."
   },
   {
    "name": "0361_1510004",
    "ko": "내 사격 솜씨\n봤어?"
   },
   {
    "name": "0361_1520004",
    "ko": "전송 장치를 파괴 안 하면\n끝이 없어."
   },
   {
    "name": "0361_1530004",
    "ko": "피그마는 어딘가에\n있는 걸까?"
   },
   {
    "name": "0361_1540004",
    "ko": "으음~ 컨디션이 안 좋네."
   },
   {
    "name": "0361_1550004",
    "ko": "이래 봬도 열심히\n하고 있는데~"
   },
   {
    "name": "0361_1560004",
    "ko": "안 질 거야~\n아직 더 할 수 있어!"
   },
   {
    "name": "0361_1570004",
    "ko": "내 아윙이\n망가져 버렸어~"
   },
   {
    "name": "0361_1580002",
    "ko": "꼴이 그게 뭐냐\n정신 차려! 폭스!"
   },
   {
    "name": "0361_1590002",
    "ko": "이런 녀석들한테\n당하지 마!"
   },
   {
    "name": "0361_1600003",
    "ko": "꽤 당했네\n폭스답지 않아."
   },
   {
    "name": "0361_1610003",
    "ko": "콜로니 안의 전투는\n치열한가 봐…"
   },
   {
    "name": "0361_1620004",
    "ko": "힘들어 보이네, 폭스\n괜찮아?"
   },
   {
    "name": "0361_1630004",
    "ko": "저 녀석들 필사적이야\n방심하면 안 돼, 폭스"
   },
   {
    "name": "0361_1640004",
    "ko": "우와, 적이 나오는\n기계가 있어!"
   },
   {
    "name": "0361_1650005",
    "ko": "그게 전송 장치다\n어서 파괴해라!"
   },
   {
    "name": "0361_1660001",
    "ko": "여기는 폭스!\n전송 장치는 전부 파괴했다!"
   },
   {
    "name": "0361_1670005",
    "ko": "잘했다. 이걸로\n콜로니를 제압할 수 있겠군."
   },
   {
    "name": "0361_1680001",
    "ko": "울프, 우리는\n싸우러 온 게 아니야."
   },
   {
    "name": "0361_1690008",
    "ko": "그렇게 멋대로 설쳐 놓고\n잘도 말하는군…"
   },
   {
    "name": "0361_1700008",
    "ko": "말은 필요 없다! 승부다!"
   },
   {
    "name": "0361_1710005",
    "ko": "어쩔 수 없군, 폭스\n아윙으로 격퇴해라."
   },
   {
    "name": "0361_1720001",
    "ko": "슬리피, 콜로니\n제압은 너한테 맡긴다."
   },
   {
    "name": "0361_1730004",
    "ko": "알았어! 폭스\n맡겨 둬~"
   },
   {
    "name": "0361_1740004",
    "ko": "어서 울프 일당을\n해치워야 해."
   },
   {
    "name": "0361_1750004",
    "ko": "콜로니 안은 이상 없음"
   },
   {
    "name": "0361_1760004",
    "ko": "우주로 안 가는 거야?\n폭스?"
   },
   {
    "name": "0361_1770004",
    "ko": "여긴 괜찮으니까\n어서 스타 울프를!"
   },
   {
    "name": "0361_1780008",
    "ko": "오랜만이군, 폭스\n상대해 주마!"
   },
   {
    "name": "0361_1790008",
    "ko": "실력이 떨어졌군, 폭스!"
   },
   {
    "name": "0361_1800008",
    "ko": "결국 네놈은\n아비를 따라갈 수 없어…"
   },
   {
    "name": "0361_1810008",
    "ko": "크악!"
   },
   {
    "name": "0361_1820008",
    "ko": "얕보지 마라, 폭스!"
   },
   {
    "name": "0361_1830008",
    "ko": "제법이군!"
   },
   {
    "name": "0361_1840008",
    "ko": "떨어져라! 폭스!"
   },
   {
    "name": "0361_1850008",
    "ko": "여기까지다!"
   },
   {
    "name": "0361_1880008",
    "ko": "건방진!"
   },
   {
    "name": "0361_1890008",
    "ko": "어디냐!"
   },
   {
    "name": "0361_1900002",
    "ko": "조심해. 울프언도\n파워업한 것 같아."
   },
   {
    "name": "0361_1910002",
    "ko": "레온 녀석, 여전히\n음흉한 놈이군!"
   },
   {
    "name": "0361_1920004",
    "ko": "다들, 스타 울프\n따위한테 질 순 없어!"
   },
   {
    "name": "0361_1930004",
    "ko": "울프 일당이 있다면\n역시 피그마도 여기에?"
   },
   {
    "name": "0361_1940003",
    "ko": "뭐야 이 녀석!\n끈질겨!"
   },
   {
    "name": "0361_1950003",
    "ko": "이 녀석들\n보통내기가 아니네!"
   },
   {
    "name": "0361_1960001",
    "ko": "울프 팀 전 기체\n격퇴했습니다."
   },
   {
    "name": "0361_1980005",
    "ko": "호밍 미사일이다!\n공중제비로 피해라!"
   },
   {
    "name": "0361_2000005",
    "ko": "폭스!\n뒤에 적이다!"
   },
   {
    "name": "0361_2020002",
    "ko": "폭스!\n뒤를 잡혔어!"
   },
   {
    "name": "0361_2030002",
    "ko": "폭스! 뒤다!"
   },
   {
    "name": "0361_2040003",
    "ko": "뒤에 적이 있어\n폭스!"
   },
   {
    "name": "0361_2050003",
    "ko": "폭스!\n뒤야!"
   },
   {
    "name": "0361_2080004",
    "ko": "지금까지는 못 봤어…"
   },
   {
    "name": "0361_2090005",
    "ko": "무법자라지만\n훈련은 받은 모양이군."
   },
   {
    "name": "0361_2100005",
    "ko": "…오이코니군보다\n성가실지도 모르겠어."
   },
   {
    "name": "0361_2110004",
    "ko": "그래도 감탄스럽네\n폭스"
   },
   {
    "name": "0361_2120001",
    "ko": "뭐가?"
   },
   {
    "name": "0361_2130004",
    "ko": "이런 낡은 기계들로\n참 잘도 버틴다 싶어서"
   },
   {
    "name": "0361_2140002",
    "ko": "네 방보단 낫잖아\n슬리피"
   },
   {
    "name": "0361_2150002",
    "ko": "저 녀석들, 필사적이군."
   },
   {
    "name": "0361_2160005",
    "ko": "어쩔 수 없지… 여기선\n우리가 침입자니까."
   },
   {
    "name": "0361_2170002",
    "ko": "헤헷, 난 그쪽이\n더 성미에 맞아."
   },
   {
    "name": "0361_2180004",
    "ko": "피그마도 오이코니도\n오랜만이지만"
   },
   {
    "name": "0361_2190004",
    "ko": "다들\n변한 게 없네~"
   },
   {
    "name": "0361_2200005",
    "ko": "제일 안 변한 건 너다\n슬리피"
   },
   {
    "name": "0361_2210005",
    "ko": "여전하구나, 울프"
   },
   {
    "name": "0361_2220008",
    "ko": "흥, 아윙에서\n내려왔다더군, 늙은이"
   },
   {
    "name": "0361_2230005",
    "ko": "너야말로 언제까지나\n젊다고 생각하지 마라."
   },
   {
    "name": "0361_2260005",
    "ko": "울프, 정말로\n피그마를 모르는 거냐!?"
   },
   {
    "name": "0361_2270008",
    "ko": "듣고 싶으면 우선\n빚부터 갚으시지!"
   },
   {
    "name": "0361_2280008",
    "ko": "폭스\n숨지 말고 낯짝 좀 보이시지!"
   },
   {
    "name": "0361_2310003",
    "ko": "울프 팀…… 과연\n실력자들만 모였단 거네."
   },
   {
    "name": "0361_2320001",
    "ko": "방심하지 마\n크리스탈!"
   },
   {
    "name": "0361_2330003",
    "ko": "걱정해 줘서 고마워. 그래도\n조금은 즐겨 볼게."
   },
   {
    "name": "0661_0490004",
    "ko": "여기는 슬리피\n상공을 제압하는 중이야!"
   },
   {
    "name": "0800_0010003",
    "ko": "적기 격추!"
   },
   {
    "name": "0800_0030002",
    "ko": "적기 격추!"
   },
   {
    "name": "0361_0790005",
    "ko": "잘했다, 폭스!\n작전 완료다!"
   },
   {
    "name": "0361_1070005",
    "ko": "잘했다! 작전 완료다!"
   },
   {
    "name": "0000_1880005",
    "ko": "그 적에게는 머신건이\n안 통한다!!"
   },
   {
    "name": "0000_1890005",
    "ko": "그 적에게는 블래스터가\n안 통한다!!"
   },
   {
    "name": "0000_2350005",
    "ko": "평행 이동을 잘 써라!\n{6030:0} 누르면서 ←{6018:4}→"
   },
   {
    "name": "0000_2380005",
    "ko": "저격총으로 먼 곳의\n적을 노릴 수 있다 {6018:5}"
   }
  ]
 }
]