  "first": "0331_0010008",
  "entries": [
   {
    "name": "0331_0010008",
    "ko": "네놈들!\n고작 여우 한 마리한테 뭘 하는 거냐!!"
   },
   {
    "name": "0331_0020013",
    "ko": "두목! 와 주셨군요~!"
   },
   {
    "name": "0331_0030001",
    "ko": "울프냐!?"
   },
   {
    "name": "0331_0040008",
    "ko": "내 구역에서 까불지 마라!"
   },
   {
    "name": "0331_0050008",
    "ko": "폭스~!!"
   },
   {
    "name": "0331_0060010",
    "ko": "크크크…\n실컷 괴롭힌 다음에 요리해 주지!"
   },
   {
    "name": "0331_0070009",
    "ko": "너희와는 초면이군. 난 팬서\n내 붉은 장미를 본 녀석은 죽는다!"
   },
   {
    "name": "0331_0080001",
    "ko": "우리가 볼일 있는 건 피그마뿐이다…\n잠자코 피그마를 넘겨줘!"
   },
   {
    "name": "0331_0090008",
    "ko": "피그마? 모르는데~"
   },
   {
    "name": "0331_0100008",
    "ko": "그보다\n자리 비운 사이에 멋대로 설쳐 댔더군."
   },
   {
    "name": "0331_0110008",
    "ko": "톡톡히 답례를 해 주마!!"
   }
  ]
 },
 {
